      unfold L logBudget
      exact add_le_add (le_refl _) (Real.log_le_log (zero_lt_one.trans_le nR) (by linarith))
  have step (j : RightLowWaveIndex) (hj : j ∈ J) : rightLowWaveStep j ∈ Icc 1 n :=
    bilateral_right_low_step_range (subset hj)
