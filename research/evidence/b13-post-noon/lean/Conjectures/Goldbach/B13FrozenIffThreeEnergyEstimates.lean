def outsideSquareKept (n : ℕ) {κ : Type} (J : Finset κ) (v p s : κ → ℕ) (w : κ → ℂ) : ℂ :=
  outsideWeightedAtGcd n (min (exteriorCommonDivisorCap n) (maximumStep n))
    ((outsideLeftTargetItems n).filter (fun i => stepWithoutLargeSquare n (leftBilinearStep i)))
    ((outsideRightTargetItems n J v).filter (fun j => stepWithoutLargeSquare n (v j)))
    v p s (leftPrimeWeight n) w

def outsideSquareCorrection (n : ℕ) {κ : Type} (J : Finset κ) (v p s : κ → ℕ) (w : κ → ℂ) : ℂ :=
  outsideWeightedAtGcd n (min (exteriorCommonDivisorCap n) (maximumStep n))
    ((outsideLeftTargetItems n).filter (fun i => ¬stepWithoutLargeSquare n (leftBilinearStep i)))
    (outsideRightTargetItems n J v) v p s (leftPrimeWeight n) w +
  outsideWeightedAtGcd n (min (exteriorCommonDivisorCap n) (maximumStep n))
    ((outsideLeftTargetItems n).filter (fun i => stepWithoutLargeSquare n (leftBilinearStep i)))
    ((outsideRightTargetItems n J v).filter (fun j => ¬stepWithoutLargeSquare n (v j)))
    v p s (leftPrimeWeight n) w

theorem outside_eq_square_kept (n : ℕ) {κ : Type} (J : Finset κ) (v p s : κ → ℕ) (w : κ → ℂ) :
