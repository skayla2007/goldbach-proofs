      ∀ u ∈ Icc 1 n, (∑ j ∈ (J n).filter (fun j => v n j=u), ‖w n j‖) ≤ T^3*logBudget n) :
    saving (fun n => removedPrefixFamily n (J n) (v n) (p n) (s n) (w n)) := by
  intro e he
  let δ := min 1 (e/34084)
  have δp : 0 < δ := lt_min zero_lt_one (div_pos he (by norm_num))
  have δe : 34084*δ ≤ e := by
    have h : δ ≤ e/34084 := min_le_right _ _
    linarith only [h]
