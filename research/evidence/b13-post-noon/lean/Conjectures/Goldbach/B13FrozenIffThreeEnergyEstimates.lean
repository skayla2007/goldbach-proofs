  have sub : ({1,n} : Finset ℕ) ⊆ n.divisors := by
    intro d hd
    simp only [mem_insert,mem_singleton] at hd
    rcases hd with rfl | rfl
    · exact Nat.mem_divisors.mpr ⟨one_dvd _,by omega⟩
    · exact Nat.mem_divisors.mpr ⟨dvd_rfl,by omega⟩
  simpa [show 1 ≠ n by omega] using card_le_card sub

theorem card_high_proper_frequency_support_le {n : ℕ} (hn : 2 ≤ n) {T : ℝ}
    (divisors : (n.divisors.card : ℝ) ≤ T) :
    ((highProperFrequencySupport n).card : ℝ) ≤ (n : ℝ)^(1-(1/2048 : ℝ))*T := by
  let A := highProperSquareCut n
  let N := (n : ℝ)
  have n1 : 1 ≤ N := by
    change (1 : ℝ) ≤ (n : ℝ)
    exact_mod_cast (show 1 ≤ n by omega)
  have n0 := zero_lt_one.trans_le n1
  have A0 : 0 < A := Nat.le_floor (Real.one_le_rpow n1 (by norm_num))
  have An : A ≤ n := Nat.floor_le_of_le (Real.rpow_le_self_of_one_le n1 (by norm_num))
  have half : N^(1/768 : ℝ)/2 ≤ (A : ℝ) := floor_half_le (Real.one_le_rpow n1 (by norm_num))
  have T2 : 2 ≤ T := (by exact_mod_cast two_le_divisor_count_of_ge_two hn :
    (2 : ℝ) ≤ n.divisors.card).trans divisors
  calc
    _ ≤ N/(A : ℝ) := card_square_multiple_support_le A0 An
    _ ≤ N/(N^(1/768 : ℝ)/2) := div_le_div_of_nonneg_left n0.le (by positivity) half
    _ = 2*(N/N^(1/768 : ℝ)) := by ring
    _ = 2*N^(767/768 : ℝ) := by
      congr 1
      calc
        _ = N^(1 : ℝ)/N^(1/768 : ℝ) := by rw [Real.rpow_one]
        _ = _ := by rw [← Real.rpow_sub n0]; norm_num
    _ ≤ _ := by
      rw [mul_comm 2]
      exact mul_le_mul (Real.rpow_le_rpow_of_exponent_le n1 (by norm_num)) T2 (by positivity) (by positivity)

end

