  have mem (t : ℝ) : t ∈ I ↔ t ∈ Set.Icc (currentBinEdge u l) (currentBinEdge u r) ∧
      x-t ∈ Set.Icc (currentBinEdge v p) (currentBinEdge v s) := by
    unfold I a b
    simp only [Set.mem_Icc,max_le_iff,le_min_iff]
