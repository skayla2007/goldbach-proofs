    (weights : ∀ n, ∀ {T : ℝ}, 1 ≤ T → (∀ z ≤ n, (z.divisors.card : ℝ) ≤ T) →
      ∀ q ∈ Icc 1 n, (∑ j ∈ (J n).filter (fun j => v j=q), ‖w n j‖) ≤ T^3*logBudget n)
