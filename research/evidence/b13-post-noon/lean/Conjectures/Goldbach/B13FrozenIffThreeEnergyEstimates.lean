  exact S

def afterWeilNearRightRamp (n : ℕ) : ℂ :=
  afterSymmetricInterior n-weilNearRightRampKept n

theorem frozen_iff_after_weil_near_right_ramp :
    frozenGoal ↔ saving afterWeilNearRightRamp := by
  rw [frozen_iff_after_symmetric_interior]
  apply saving_equiv_of_negligible_correction _ weil_near_right_ramp_kept_saving
  intro n
  unfold afterWeilNearRightRamp
  ring

