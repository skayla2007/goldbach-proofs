    dsimp [c]
    rw [← Real.rpow_add_one N0.ne']
    norm_num
  have powR : c⁻¹*N^(47/48 : ℝ) = N^(95/96 : ℝ) := by
    dsimp [c]
    rw [← Real.rpow_neg N0.le, neg_neg, ← Real.rpow_add N0]
