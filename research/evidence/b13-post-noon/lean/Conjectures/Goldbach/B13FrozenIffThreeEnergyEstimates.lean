    (outsideLeftItems n) (outsideProperPowerItems n)
    leftBilinearStep (fun _ => 0) (fun i => n/leftBilinearStep i) rightLowWaveStep
    (fun _ => 0) (rightLowWaveUpper n) (leftBilinearWeight n) rightLowWaveWeight

theorem norm_outside_proper_power_contribution_le {n : ℕ} (n2 : 2 ≤ n)
    {T : ℝ} (T1 : 1 ≤ T) (divisors : ∀ m ≤ n, (m.divisors.card : ℝ) ≤ T) :
    ‖outsideProperPowerContribution n‖ ≤ (15/2)*(n : ℝ)^(95/96 : ℝ)*T^10*logBudget n^3 := by
  let N := (n : ℝ)
  let L := logBudget n
  let W := T^3*L
  let c := N^(-(1/96) : ℝ)
  have n0 : 0 < n := by omega
  have N0 : 0 < N := by
    change (0 : ℝ) < (n : ℝ)
    exact_mod_cast n0
  have L0 : 0 ≤ L := zero_le_one.trans (one_le_logBudget n)
  have T0 : 0 ≤ T := zero_le_one.trans T1
  have W0 : 0 ≤ W := mul_nonneg (pow_nonneg T0 _) L0
  have c0 : 0 < c := Real.rpow_pos_of_pos N0 _
  let SL := Icc 1 n
  let SR := squareMultipleSupport n (properPowerSquareCut n)
  have Istep (i : ℕ × ℕ) (hi : i ∈ outsideLeftItems n) :
      leftBilinearStep i ∈ Icc 1 n := bilateral_left_step_range (mem_filter.mp hi).1
  have Jstep (j : RightLowWaveIndex) (hj : j ∈ outsideProperPowerItems n) :
      rightLowWaveStep j ∈ Icc 1 n := bilateral_right_low_step_range (mem_filter.mp hj).1
  have Imass (q : ℕ) (hq : q ∈ Icc 1 n) :
      (∑ i ∈ (outsideLeftItems n).filter (fun i => leftBilinearStep i=q),
        ‖leftBilinearWeight n i‖) ≤ W := by
    exact (sum_le_sum_of_subset_of_nonneg (filter_subset_filter _ (filter_subset _ _))
      (fun _ _ _ => norm_nonneg _)).trans (norm_bilateral_left_step_mass n0 T0 divisors q hq)
  have Jmass (q : ℕ) (hq : q ∈ Icc 1 n) :
      (∑ j ∈ (outsideProperPowerItems n).filter (fun j => rightLowWaveStep j=q),
        ‖rightLowWaveWeight j‖) ≤ W := by
    exact (sum_le_sum_of_subset_of_nonneg (filter_subset_filter _ (filter_subset _ _))
      (fun _ _ _ => norm_nonneg _)).trans (norm_bilateral_right_low_step_mass T1 divisors q hq)
