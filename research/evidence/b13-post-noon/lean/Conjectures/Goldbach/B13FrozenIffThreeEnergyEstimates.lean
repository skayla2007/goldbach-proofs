theorem saving_equiv_of_negligible_correction {f g h : ℕ → ℂ}
    (eq : ∀ n : ℕ, f n = g n + h n) (small : saving h) : saving f ↔ saving g := by
  constructor <;> intro H e he <;>
    obtain ⟨N,hN⟩ := H (e/2) (by positivity) <;>
    obtain ⟨M,hM⟩ := small (e/2) (by positivity) <;>
    refine ⟨max N M,fun n hn even => ?_⟩
  · rw [show g n = f n - h n from (eq_sub_of_add_eq (eq n).symm)]
    exact (norm_sub_le _ _).trans (by linarith only [hN n (by omega) even,hM n (by omega) even])
  · rw [eq n]
    exact (norm_add_le _ _).trans (by linarith only [hN n (by omega) even,hM n (by omega) even])

def outsideAfterTargetTrimming (n : ℕ) : ℂ :=
  outsideTargetKeptFrom n (lowPrimeItems n) rightLowWaveStep
    (fun _ => 0) (rightLowWaveUpper n) rightLowWaveWeight +
  outsideTargetKeptFrom n (rightHighWaveItems n) rightHighWaveStep (rightHighWaveLower n)
    (fun j => n/rightHighWaveStep j) (rightHighWaveWeight n)

def outsideTargetTrimming (n : ℕ) : ℂ :=
  outsideTargetCutFrom n (lowPrimeItems n) rightLowWaveStep
    (fun _ => 0) (rightLowWaveUpper n) rightLowWaveWeight +
  outsideTargetCutFrom n (rightHighWaveItems n) rightHighWaveStep (rightHighWaveLower n)
    (fun j => n/rightHighWaveStep j) (rightHighWaveWeight n)

theorem outside_prime_eq_target_trimming (n : ℕ) :
    outsideExpandedAfterProperPower n = outsideAfterTargetTrimming n + outsideTargetTrimming n := by
  unfold outsideExpandedAfterProperPower outsideAfterTargetTrimming outsideTargetTrimming
  rw [outside_expanded_eq_target_partition,outside_expanded_eq_target_partition]
  abel

theorem outside_target_trimming_saving : saving outsideTargetTrimming := by
  have lowMass (n : ℕ) (T : ℝ) (T1 : 1 ≤ T) (d : ∀ u ≤ n, (u.divisors.card : ℝ) ≤ T)
      (m : ℕ) (hm : m ∈ Icc 1 n) :
      (∑ j ∈ (lowPrimeItems n).filter (fun j => rightLowWaveStep j=m), ‖rightLowWaveWeight j‖) ≤
        T^3*logBudget n :=
    (sum_le_sum_of_subset_of_nonneg (filter_subset_filter _ (filter_subset _ _))
      (fun _ _ _ => norm_nonneg _)).trans (norm_bilateral_right_low_step_mass T1 d m hm)
  have hlow := outside_target_cut_from_saving lowPrimeItems (fun _ => rightLowWaveStep)
    (fun _ _ => 0) rightLowWaveUpper (fun _ => rightLowWaveWeight)
    (fun _ _ hj => bilateral_right_low_step_range (mem_filter.mp hj).1) (fun _ _ _ => min_le_right _ _) lowMass
  have hhigh := outside_target_cut_from_saving rightHighWaveItems (fun _ => rightHighWaveStep)
    rightHighWaveLower (fun n j => n/rightHighWaveStep j) rightHighWaveWeight
    (fun _ _ hj => bilateral_right_high_step_range hj) (fun _ _ _ => le_rfl)
    (fun _ _ t d m hm => norm_bilateral_right_high_step_mass (zero_le_one.trans t) d m hm)
  intro e he
  obtain ⟨N,hN⟩ := hlow (e/2) (by positivity)
  obtain ⟨M,hM⟩ := hhigh (e/2) (by positivity)
  refine ⟨max N M,fun n hn even => ?_⟩
  unfold outsideTargetTrimming
  exact (norm_add_le _ _).trans (by linarith only [hN n (by omega) even,hM n (by omega) even])

theorem frozen_iff_after_outside_target_trimming :
    frozenGoal ↔ saving (fun n => farInnerAfterTrimming n + outsideAfterTargetTrimming n) := by
  rw [frozen_iff_after_outer_proper_power]
  apply saving_equiv_of_negligible_correction _ outside_target_trimming_saving
  intro n
