    apply Nat.le_floor
    rw [Nat.cast_pow]
    refine (pow_le_pow_left₀ (by positivity) (Nat.floor_le (by positivity)) 3).trans_eq ?_
    rw [← Real.rpow_mul_natCast (by positivity)]
    norm_num
  exact large_prime_power_mem_square_support m0 mn (cube.trans_lt big) nonprime power
    d

