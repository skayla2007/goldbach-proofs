    bilateral_right_low_step_range (long_right_low_subset n hj)
  have highBase (n : ℕ) : longRightHighItems n ⊆ rightHighWaveItems n := filter_subset _ _
  have high (n : ℕ) (j : RightHighWaveIndex) (hj : j ∈ longRightHighItems n) : v₃ j ∈ Icc 1 n :=
    bilateral_right_high_step_range (highBase n hj)
  have lowMass (n : ℕ) (T : ℝ) (hT : 1 ≤ T) (d : ∀ m ≤ n, (m.divisors.card : ℝ) ≤ T)
      (q : ℕ) (hq : q ∈ Icc 1 n) :
      (∑ j ∈ (longRightLowItems n).filter (fun j => v₁ j=q), ‖rightLowWaveWeight j‖) ≤ T^3*logBudget n :=
    long_right_low_step_mass hT d q hq
  have highMass (n : ℕ) (T : ℝ) (hT : 1 ≤ T) (d : ∀ m ≤ n, (m.divisors.card : ℝ) ≤ T)
      (q : ℕ) (hq : q ∈ Icc 1 n) :
      (∑ j ∈ (longRightHighItems n).filter (fun j => v₃ j=q), ‖w₃ n j‖) ≤ T^3*logBudget n :=
