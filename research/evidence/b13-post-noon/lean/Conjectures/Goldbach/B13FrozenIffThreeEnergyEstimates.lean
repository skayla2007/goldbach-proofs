def insideAfterShortRight (n : ℕ) : ℂ :=
  farInnerThinFrom n (longRightLowItems n) rightLowWaveStep
    (fun _ => 0) (rightLowWaveUpper n) rightLowWaveWeight +
  farInnerThinFrom n (rightHighWaveItems n) rightHighWaveStep
    (rightHighWaveLower n) (fun j => n/rightHighWaveStep j) (rightHighWaveWeight n)

def outsideAfterShortRight (n : ℕ) : ℂ :=
  outsideTargetKeptFrom n (longRightLowItems n) rightLowWaveStep
    (fun _ => 0) (rightLowWaveUpper n) rightLowWaveWeight +
  outsideTargetKeptFrom n (rightHighWaveItems n) rightHighWaveStep
    (rightHighWaveLower n) (fun j => n/rightHighWaveStep j) (rightHighWaveWeight n)

