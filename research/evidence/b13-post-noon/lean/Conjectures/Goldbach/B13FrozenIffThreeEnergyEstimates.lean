        ‖rightHighPrimeWeight n j‖) ≤ T^3*logBudget n :=
    (sum_le_sum_of_subset_of_nonneg (filter_subset_filter _ (highRightBase n))
      (fun _ _ _ => norm_nonneg _)).trans
      (norm_bilateral_right_high_restricted_mass Nat.Prime (zero_le_one.trans T1) d q hq)
  have low := symmetric_inner_correction_saving lowInteriorLeftItems longRightLowItems rightLowWaveStep
    (fun _ _ => 0) (fun _ => rightLowWaveWeight) lowInteriorGate lowLeftBase
    (fun _ _ _ hi => (mem_filter.mp (mem_filter.mp hi).1).2) lowRight
    (fun _ _ T1 d q hq => long_right_low_step_mass T1 d q hq)
  have high := symmetric_inner_correction_saving highInteriorLeftItems highInteriorRightItems rightHighWaveStep
    rightHighWaveLower rightHighPrimeWeight highInteriorGate (fun _ => filter_subset _ _)
    (fun _ _ _ hi => (mem_filter.mp hi).2) highRight highMass
  exact saving_sum_two low high

theorem frozen_iff_after_symmetric_interior : frozenGoal ↔ saving afterSymmetricInterior := by
  rw [frozen_iff_after_low_geometry]
  apply saving_equiv_of_negligible_correction _ symmetric_interior_correction_saving
  intro n
  unfold afterLowGeometry afterSymmetricInterior symmetricInteriorCorrection
  change (selectedInnerResidue n (lowInteriorLeftItems n) (longRightLowItems n) rightLowWaveStep
      (fun _ => 0) (fun j => n/rightLowWaveStep j) (leftPrimeWeight n) rightLowWaveWeight (lowInteriorGate n) +
    selectedInnerResidue n (highInteriorLeftItems n) (highInteriorRightItems n) rightHighWaveStep
      (rightHighWaveLower n) (fun j => n/rightHighWaveStep j) (leftPrimeWeight n)
      (rightHighPrimeWeight n) (highInteriorGate n)) + _ = _
  rw [selected_inner_eq_symmetric,selected_inner_eq_symmetric]
  abel

end

end GoldbachTypeII13

