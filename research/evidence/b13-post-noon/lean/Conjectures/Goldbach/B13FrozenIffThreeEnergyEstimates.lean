      sum_le_sum fun i hi => mul_le_mul_of_nonneg_left (each i hi) (norm_nonneg _)
    _ = ∑ u ∈ S, (∑ i ∈ J.filter (fun i => g i=u), ‖c i‖) * F u := by
      rw [← sum_fiberwise_of_maps_to range (fun i => ‖c i‖*F (g i))]
