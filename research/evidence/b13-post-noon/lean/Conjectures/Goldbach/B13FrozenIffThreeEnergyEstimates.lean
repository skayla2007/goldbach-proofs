    (fun n j hj => rStep n j (mem_filter.mp hj).1) (fun n j hj => rEnd n j (mem_filter.mp hj).1) selectiveMass
    (fun _ _ _ _ hm _ hit => frequency_in_positive_range hm hit) rightSparse basic sparse
