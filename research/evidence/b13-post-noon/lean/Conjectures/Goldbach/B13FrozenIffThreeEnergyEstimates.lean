noncomputable section

def targetDivisorKept (n u : ℕ) : Prop := u.gcd n ≤ sparseTargetDivisorCap n

def outsideTargetKeptFrom (n : ℕ) {κ : Type} (J : Finset κ)
    (v p s : κ → ℕ) (w : κ → ℂ) : ℂ :=
  outsideExpandedAgainst n ((bilateralLeftWaveItems n).filter (fun i => targetDivisorKept n (leftBilinearStep i)))
    (J.filter (fun j => targetDivisorKept n (v j))) v p s w

def outsideTargetCutFrom (n : ℕ) {κ : Type} (J : Finset κ)
    (v p s : κ → ℕ) (w : κ → ℂ) : ℂ :=
  outsideExpandedAgainst n
    ((bilateralLeftWaveItems n).filter (fun i => ¬targetDivisorKept n (leftBilinearStep i))) J v p s w +
  outsideExpandedAgainst n
    ((bilateralLeftWaveItems n).filter (fun i => targetDivisorKept n (leftBilinearStep i)))
    (J.filter (fun j => ¬targetDivisorKept n (v j))) v p s w

theorem outside_expanded_eq_target_partition (n : ℕ) {κ : Type} (J : Finset κ)
    (v p s : κ → ℕ) (w : κ → ℂ) :
    outsideExpandedFrom n J v p s w =
