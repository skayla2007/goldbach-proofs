            mul_le_mul_of_nonneg_right (weights d hd) (norm_nonneg _)
          _ ≤ T*((c*F k d h+c⁻¹*G k d h)/2) :=
            mul_le_mul_of_nonneg_left (norm_masked_wave_product_le (fc k d h) (gc k d h) c0) T0
