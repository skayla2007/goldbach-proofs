      ext j
      simp only [mem_Ioc, mem_Ico]
      omega
    have out : ¬ r+1 ≤ r := by omega
    have last : ‖(logWaveStep r r : ℂ)‖ = Real.log r := by
      unfold logWaveStep
      rw [Complex.norm_real, Real.norm_eq_abs]
