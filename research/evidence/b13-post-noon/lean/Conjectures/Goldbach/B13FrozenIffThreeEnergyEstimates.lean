    (suppL : ∀ i ∈ I, ∀ m ≤ n, u i ∣ m → m/u i ∈ Ioc (l i) (r i) → m ∈ SL)
    (suppR : ∀ j ∈ J, ∀ m ≤ n, v j ∣ m → m/v j ∈ Ioc (p j) (s j) → m ∈ SR) :
