theorem removed_prefix_family_saving {κ : Type} (J : ℕ → Finset κ)
    (v p s : ℕ → κ → ℕ) (w : ℕ → κ → ℂ)
    (steps : ∀ n j, j ∈ J n → v n j ∈ Icc 1 n)
    (ends : ∀ n j, j ∈ J n → s n j ≤ n/v n j)
