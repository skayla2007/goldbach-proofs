  let f (m : ℕ) : ℂ := phase ((m : ℝ) * t)
  let U := cutoffU n
  have cast (lo m : ℕ) :
      (↑(upperBandWeight (R := ℝ) (cutoffU n) lo (fun d => (μ d : ℝ)) weight m) : ℂ) =
