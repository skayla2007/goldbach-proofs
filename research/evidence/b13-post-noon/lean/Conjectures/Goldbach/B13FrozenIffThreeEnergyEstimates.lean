      (pairResidueError n (v j) (u i) (p j) (s j) (l i) (r i) : ℂ)) else 0

theorem pair_residue_swap_family_eq_rounding_difference (n : ℕ) {α β : Type*}
    (I : Finset α) (J : Finset β)
    (u l r : α → ℕ) (v p s : β → ℕ) (a : α → ℂ) (b : β → ℂ) (gate : α → β → Prop)
