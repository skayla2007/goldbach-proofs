    _ ≤ (n : ℝ)/(properPowerSquareCut n : ℝ) := card_square_multiple_support_le A0 An
    _ ≤ (n : ℝ)/((n : ℝ)^(1/48 : ℝ)/2) :=
      div_le_div_of_nonneg_left (by positivity) (by positivity) low
