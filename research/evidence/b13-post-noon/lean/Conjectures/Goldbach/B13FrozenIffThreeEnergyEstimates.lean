      rw [show (d : ℝ)*(1/(u : ℝ)+1/(v : ℝ)) = (d : ℝ)/u+(d : ℝ)/v by ring,
        show 3*(d : ℝ)*(1/(u : ℝ)+1/(v : ℝ)) = 3*((d : ℝ)/u+(d : ℝ)/v) by ring]
      exact abs_le.mpr ⟨by linarith only [eBound.1,au,av],by linarith only [eTop,au,av]⟩
    · obtain ⟨a0,_,bUb,_⟩ := full_pair_integer_endpoints (n := n) (p := p) hu hv
      have noOrder : ¬pairLeftLower n u v 0 (n/v) ≤ pairLeftUpper n u v (n/u) p := by
        intro h
        have bu : 0 ≤ pairLeftUpper n u v (n/u) p*(u : ℤ) :=
          mul_nonneg (a0.trans h) (by positivity)
