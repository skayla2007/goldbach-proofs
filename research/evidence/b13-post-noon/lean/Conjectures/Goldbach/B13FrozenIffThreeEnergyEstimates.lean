section

namespace GoldbachTypeII13

open Finset
open DyadicMixedB4ArcGeometry
open scoped Classical

noncomputable section

private theorem reduce_rational_center {B q a : ℕ} (q0 : 0 < q) (qB : q ≤ B) (aq : a ≤ q) :
    let c := (q/a.gcd q,a/a.gcd q)
    c ∈ reducedRationalCenters B ∧ rationalCenter c = (a : ℝ)/q := by
  let g := a.gcd q
  have g0 : 0 < g := Nat.gcd_pos_of_pos_right _ q0
  have gd := Nat.gcd_dvd_right a q
  have ga := Nat.gcd_dvd_left a q
  have den0 : 0 < q/g := Nat.div_pos (Nat.le_of_dvd q0 gd) g0
  have cos := Nat.coprime_div_gcd_div_gcd g0
  refine ⟨mem_reduced_rational_centers.mpr ⟨den0,(Nat.div_le_self _ _).trans qB,Nat.div_le_div_right aq,cos⟩,?_⟩
  change ((a/g : ℕ) : ℝ)/((q/g : ℕ) : ℝ) = (a : ℝ)/q
  have aa : ((a/g : ℕ) : ℝ)*(g : ℝ) = a := by exact_mod_cast Nat.div_mul_cancel ga
  have qq : ((q/g : ℕ) : ℝ)*(g : ℝ) = q := by exact_mod_cast Nat.div_mul_cancel gd
  rw [← mul_div_mul_right _ _ (by exact_mod_cast g0.ne' : (g : ℝ) ≠ 0),aa,qq]

private theorem scaled_center_bounds {d q a k : ℕ} (q0 : 0 < q) {z epsilon : ℝ}
    (z0 : 0 ≤ z) (z1 : z ≤ 1) (thin : epsilon < 1)
    (near : |z-((d : ℝ)*(a : ℝ)/q-(k : ℝ))| ≤ epsilon/(q : ℝ)) :
    q*k ≤ d*a ∧ d*a ≤ q*k+q := by
  let D : ℝ := (d : ℝ)*a-(q : ℝ)*k
  have qR : (0 : ℝ) < q := by exact_mod_cast q0
  have eta : |z-D/(q : ℝ)| ≤ epsilon/(q : ℝ) := by
    convert near using 3
    unfold D
    field_simp <;> ring
  have radius : epsilon/(q : ℝ) < 1/(q : ℝ) := (div_lt_div_iff_of_pos_right qR).mpr thin
  obtain ⟨lo,hi⟩ := abs_le.mp eta
  constructor
  · by_contra! h
    have exactGap : (d : ℝ)*a + 1 ≤ (q : ℝ)*k := by exact_mod_cast Nat.succ_le_of_lt h
    have Dneg : D/(q : ℝ) ≤ -(1/(q : ℝ)) := by
      rw [← neg_div]
      exact (div_le_div_iff_of_pos_right qR).mpr (by unfold D; linarith only [exactGap])
    linarith only [hi,Dneg,z0,radius]
  · by_contra! h
    have exactGap : (q : ℝ)*k + (q : ℝ) + 1 ≤ (d : ℝ)*a := by exact_mod_cast Nat.succ_le_of_lt h
    have Dpos : 1+1/(q : ℝ) ≤ D/(q : ℝ) := by
      calc
        _ = ((q : ℝ)+1)/(q : ℝ) := by field_simp
        _ ≤ _ := (div_le_div_iff_of_pos_right qR).mpr (by unfold D; linarith only [exactGap])
    linarith only [lo,Dpos,z1,radius]

theorem wide_mem_iff_orbit_center_hit {n B H d k : ℕ} (n0 : 0 < n) (d0 : 0 < d) (hk : k < d)
    {t : ℝ} (t0 : 0 ≤ t) (t1 : (d : ℝ)*t ≤ 1) (small : (d : ℝ)*H/n < 1) :
    t+(k : ℝ)/d ∈ wide n B H ↔ ∃ c ∈ reducedRationalCenters B, orbitCenterHit n B H d k t c := by
  have dR : (0 : ℝ) < d := by exact_mod_cast d0
  have nR : (0 : ℝ) < n := by exact_mod_cast n0
  constructor
  · rintro ⟨q,a,q0,qB,aq,cop,near⟩
    have qR : (0 : ℝ) < q := by exact_mod_cast q0
    have scaled : |(d : ℝ)*t-((d : ℝ)*(a : ℝ)/q-(k : ℝ))| ≤ ((d : ℝ)*H/n)/(q : ℝ) := by
      calc
        _ = |(d : ℝ)*(t+(k : ℝ)/d-(a : ℝ)/q)| := by
          congr 1
          field_simp <;> ring
        _ = (d : ℝ)*|t+(k : ℝ)/d-(a : ℝ)/q| := by rw [abs_mul,abs_of_nonneg dR.le]
        _ ≤ (d : ℝ)*((H : ℝ)/((q : ℝ)*n)) := mul_le_mul_of_nonneg_left near dR.le
        _ = _ := by field_simp <;> ring
    obtain ⟨lower,upper⟩ := scaled_center_bounds q0 (mul_nonneg dR.le t0) t1 small scaled
    let a' := d*a-q*k
    have Ha : a' ≤ q := Nat.sub_le_iff_le_add.mpr (by simpa only [Nat.add_comm] using upper)
    let c := (q/a'.gcd q,a'/a'.gcd q)
    obtain ⟨mem,val⟩ : c ∈ reducedRationalCenters B ∧ rationalCenter c = (a' : ℝ)/q :=
      reduce_rational_center q0 qB Ha
    obtain ⟨lift0,_,copLift,_,liftEq⟩ := orbit_lift_data d0 hk mem
    have same : ((orbitLiftNumerator d k c : ℝ)/orbitLiftDenominator d k c) = (a : ℝ)/q := by
      rw [liftEq,val]
      unfold a'
      rw [Nat.cast_sub lower]
      push_cast
      field_simp <;> ring
    obtain ⟨den,num⟩ := reduced_rational_center_injective lift0 q0 copLift cop same
    refine ⟨c,mem,(orbit_lift_hit_iff n0 d0 hk mem t).mpr ?_⟩
    rw [den,num]
    exact ⟨qB,near⟩
  · rintro ⟨c,base,hit⟩
    have z := (orbit_lift_hit_iff n0 d0 hk base t).mp hit
    obtain ⟨r0,nb,cop,_,_⟩ := orbit_lift_data d0 hk base
    exact ⟨orbitLiftDenominator d k c,orbitLiftNumerator d k c,r0,z.1,nb,cop,z.2⟩

theorem orbit_center_hit_mem_nearby {n B H d k : ℕ} (n0 : 0 < n) (d0 : 0 < d) {t : ℝ} {c : ℕ × ℕ}
    (mem : c ∈ reducedRationalCenters B) (hit : orbitCenterHit n B H d k t c) :
    c ∈ nearbyRationalCenters B ((d : ℝ)*t) ((d : ℝ)*H/n) := by
  have qR : (0 : ℝ) < c.1 := by exact_mod_cast (mem_reduced_rational_centers.mp mem).1
  have nR : (0 : ℝ) < n := by exact_mod_cast n0
  have gd : (orbitLiftGcd d k c : ℝ) ≤ d := by exact_mod_cast Nat.gcd_le_left _ d0
  refine mem_filter.mpr ⟨mem,hit.2.trans ?_⟩
  calc
    _ ≤ (H : ℝ)*(d : ℝ)/((n : ℝ)*c.1) :=
      div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left gd (by positivity)) (mul_nonneg nR.le qR.le)
    _ = _ := by field_simp <;> ring

theorem orbit_center_hit_as_threshold {n B H d : ℕ} (d0 : 0 < d) (n0 : 0 < n) (t : ℝ)
    {c : ℕ × ℕ} (mem : c ∈ reducedRationalCenters B) :
    ∃ C : ℕ, ∀ k, orbitCenterHit n B H d k t c ↔ C < orbitLiftGcd d k c := by
  let P (g : ℕ) : Prop := 0 < g ∧ d*c.1/g ≤ B ∧
    |(d : ℝ)*t-rationalCenter c| ≤ (H : ℝ)*g/((n : ℝ)*c.1)
  have mono (g h : ℕ) (le : g ≤ h) (hg : P g) : P h := by
    have nR : (0 : ℝ) < n := by exact_mod_cast n0
    have qR : (0 : ℝ) < c.1 := by exact_mod_cast (mem_reduced_rational_centers.mp mem).1
    have hR : (g : ℝ) ≤ h := by exact_mod_cast le
    exact ⟨hg.1.trans_le le,(Nat.div_le_div_left le hg.1).trans hg.2.1,hg.2.2.trans
      (div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left hR (by positivity)) (mul_nonneg nR.le qR.le))⟩
  have pos (k : ℕ) : 0 < orbitLiftGcd d k c := Nat.gcd_pos_of_pos_left _ d0
  by_cases ex : ∃ g, P g
  · let lo := Nat.find ex
    have hP : P lo := Nat.find_spec ex
    have lo0 := hP.1
    refine ⟨lo-1,fun k => ?_⟩
    change _ ↔ lo-1 < orbitLiftGcd d k c
    have cond : orbitCenterHit n B H d k t c ↔ P (orbitLiftGcd d k c) :=
      ⟨fun h => ⟨pos k,h⟩,fun h => h.2⟩
    rw [cond]
    constructor
    · intro h
      have hmin : lo ≤ orbitLiftGcd d k c := Nat.find_min' ex h
      omega
    · intro h
      exact mono lo (orbitLiftGcd d k c) (by omega) hP
  · refine ⟨d,fun k => ?_⟩
    have upper : orbitLiftGcd d k c ≤ d := Nat.gcd_le_left _ d0
    exact ⟨fun h => (ex ⟨_,pos k,h⟩).elim,fun h => (not_lt_of_ge upper h).elim⟩

end

end GoldbachTypeII13

end

/- Source PEqualNP.Outside.L_b13_signed_wide_orbit_arithmetic -/
section

namespace GoldbachTypeII13

open Finset
open DyadicMixedB4Geometric DyadicMixedB4ArcGeometry DyadicMixedB4GaussLift
open DyadicMixedB4MoebiusGauss DyadicMixedB4Ramanujan
open scoped Classical

noncomputable section

private theorem orbit_phase_add (x y : ℝ) : phase (x+y) = phase x*phase y := by
  unfold phase
  rw [show ((↑(2*Real.pi*(x+y)) : ℂ)*Complex.I) =
    ((↑(2*Real.pi*x) : ℂ)*Complex.I)+((↑(2*Real.pi*y) : ℂ)*Complex.I) by push_cast; ring,
    Complex.exp_add]

private theorem norm_coprime_divisibility_residue_sum_le_one {n d a q r : ℕ} (r0 : 0 < r)
    (cop : a.Coprime q) :
    ‖∑ b ∈ range r, if r ∣ a+q*b then phase ((n : ℝ)*b/d) else 0‖ ≤ 1 := by
  let A := (range r).filter (fun b => r ∣ a+q*b)
  have card : A.card ≤ 1 := by
    apply Finset.card_le_one.mpr
    intro x hx y hy
    obtain ⟨hxR,hxD⟩ := mem_filter.mp hx
    obtain ⟨hyR,hyD⟩ := mem_filter.mp hy
    have dq : r.gcd q ∣ a := by
      have h₁ := (Nat.gcd_dvd_left r q).trans hxD
      have h₂ := dvd_mul_of_dvd_left (Nat.gcd_dvd_right r q) x
      exact (Nat.dvd_add_iff_left h₂).mpr h₁
    have key : r.gcd q = 1 := by
      have h := Nat.dvd_gcd dq (Nat.gcd_dvd_right r q)
      rw [cop.gcd_eq_one] at h
      exact Nat.dvd_one.mp h
    have hs : a+q*x ≡ a+q*y [MOD r] :=
      (Nat.modEq_zero_iff_dvd.mpr hxD).trans (Nat.modEq_zero_iff_dvd.mpr hyD).symm
    have he := Nat.ModEq.cancel_left_of_coprime key (Nat.ModEq.add_left_cancel' a hs)
    exact he.eq_of_lt_of_lt (mem_range.mp hxR) (mem_range.mp hyR)
  change ‖∑ b ∈ range r, if r ∣ a+q*b then phase ((n : ℝ)*b/d) else 0‖ ≤ _
  rw [← sum_filter]
  exact (norm_sum_le _ _).trans (by simpa only [A,norm_phase',sum_const,nsmul_eq_mul,mul_one] using
    (show (A.card : ℝ) ≤ 1 by exact_mod_cast card))

/-- A divisibility condition selects at most one residue modulo the divisor.
The sum along that residue vanishes unless the step divides the frequency. -/
theorem norm_coprime_divisibility_character_sum_le_gcd {n d a q r : ℕ}
    (d0 : 0 < d) (divisor : r ∣ d) (cop : a.Coprime q) :
    ‖∑ k ∈ range d, if r ∣ a+q*k then phase ((n : ℝ)*k/d) else 0‖ ≤ (d.gcd n : ℝ) := by
  obtain ⟨f,rfl⟩ := divisor
  have r0 : 0 < r := Nat.pos_of_ne_zero (by
    intro h
    simp [h] at d0)
  have f0 : 0 < f := Nat.pos_of_ne_zero (by
    intro h
    simp [h] at d0)
  letI : NeZero f := ⟨f0.ne'⟩
  have rR : (r : ℝ) ≠ 0 := by exact_mod_cast r0.ne'
  have fR : (f : ℝ) ≠ 0 := by exact_mod_cast f0.ne'
  have entry (j b : ℕ) :
      (if r ∣ a+q*(r*j+b) then phase ((n : ℝ)*(r*j+b : ℕ)/(r*f : ℕ)) else 0) =
      (if r ∣ a+q*b then phase ((n : ℝ)*b/(r*f : ℕ)) else 0) *
        phase ((n : ℝ)*j/f) := by
    have div : r ∣ a+q*(r*j+b) ↔ r ∣ a+q*b := by
      rw [show a+q*(r*j+b) = (a+q*b)+r*(q*j) by ring]
      exact (Nat.dvd_add_iff_left (dvd_mul_right r (q*j))).symm
    have angle : (n : ℝ)*(r*j+b : ℕ)/(r*f : ℕ) =
        (n : ℝ)*b/(r*f : ℕ)+(n : ℝ)*j/f := by
      push_cast
      field_simp
      ring
    by_cases h : r ∣ a+q*b
    · rw [if_pos (div.mpr h),if_pos h,angle,orbit_phase_add]
    · rw [if_neg (fun hd => h (div.mp hd)),if_neg h,zero_mul]
  have charSum : (∑ j ∈ range f, phase ((n : ℝ)*j/f)) = if f ∣ n then (f : ℂ) else 0 := by
    simpa only [phase_eq_additivePhase] using sum_phase_fraction_eq_if_dvd (q := f) n
  have eq : (∑ k ∈ range (r*f), if r ∣ a+q*k then phase ((n : ℝ)*k/(r*f : ℕ)) else 0) =
      (∑ b ∈ range r, if r ∣ a+q*b then phase ((n : ℝ)*b/(r*f : ℕ)) else 0) *
      (if f ∣ n then (f : ℂ) else 0) := by
    rw [sum_range_blocks,Finset.sum_comm]
    simp_rw [entry,← mul_sum,charSum,← sum_mul]
  rw [eq]
  by_cases hf : f ∣ n
  · rw [if_pos hf,norm_mul,Complex.norm_natCast]
    have d : f ∣ (r*f).gcd n := Nat.dvd_gcd (dvd_mul_left f r) hf
    have fG : f ≤ (r*f).gcd n := Nat.le_of_dvd (Nat.gcd_pos_of_pos_left _ d0) d
    calc
      _ ≤ (1 : ℝ)*f := mul_le_mul_of_nonneg_right (norm_coprime_divisibility_residue_sum_le_one r0 cop) (by positivity)
      _ ≤ _ := by rw [one_mul]; exact_mod_cast fG
  · simp [hf]

/-- The signed mass of a gcd threshold in one lifted rational orbit. -/
theorem norm_gcd_threshold_character_sum_le {n d a q C : ℕ} (d0 : 0 < d) (cop : a.Coprime q) :
    ‖∑ k ∈ range d, if d.gcd (a+q*k) ≤ C then phase ((n : ℝ)*k/d) else 0‖ ≤
      (d.divisors.card : ℝ)^2 * (d.gcd n : ℝ) := by
  let P (k : ℕ) := phase ((n : ℝ)*k/d)
  have entry (k : ℕ) : (if d.gcd (a+q*k) ≤ C then P k else 0) =
      ∑ r ∈ d.divisors, if r ∣ a+q*k then gcdCutCoefficient C r * P k else 0 := by
    have same : d.divisors.filter (fun r => r ∣ a+q*k) = (d.gcd (a+q*k)).divisors := by
      ext r
      constructor
      · rintro hm
        obtain ⟨hd,ha⟩ := mem_filter.mp hm
        exact Nat.mem_divisors.mpr ⟨Nat.dvd_gcd (Nat.dvd_of_mem_divisors hd) ha,
          (Nat.gcd_pos_of_pos_left _ d0).ne'⟩
      · intro hg
        have div := Nat.dvd_of_mem_divisors hg
        exact mem_filter.mpr ⟨Nat.mem_divisors.mpr ⟨div.trans (Nat.gcd_dvd_left _ _),d0.ne'⟩,
          div.trans (Nat.gcd_dvd_right _ _)⟩
    have cut := sum_gcd_cut_coefficient C (d.gcd (a+q*k)) (Nat.gcd_pos_of_pos_left _ d0)
    rw [← sum_filter,same,← sum_mul,cut]
    by_cases h : d.gcd (a+q*k) ≤ C <;> simp [h]
