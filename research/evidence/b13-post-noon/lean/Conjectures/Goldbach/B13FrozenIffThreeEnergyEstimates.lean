      refine (abs_add_le _ _).trans ?_
      rw [abs_pow,abs_mul,abs_mul,abs_of_pos pp]
      calc
        _ ≤ P^2+(P*(3*P))*P := add_le_add (pow_le_pow_left₀ (abs_nonneg _) ss 2)
          (mul_le_mul_of_nonneg_right (mul_le_mul tt kk (abs_nonneg _) pp.le) pp.le)
        _ = P^2+3*P^3 := by ring
        _ ≤ _ := by
