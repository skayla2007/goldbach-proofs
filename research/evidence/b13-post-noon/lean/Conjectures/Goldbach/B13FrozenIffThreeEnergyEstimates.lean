def outsideExpandedFrom (n : ℕ) {κ : Type} (J : Finset κ)
    (v p s : κ → ℕ) (w : κ → ℂ) : ℂ :=
  ∑ i ∈ bilateralLeftWaveItems n, ∑ j ∈ J,
    let u := leftBilinearStep i
    @ite ℂ (prefixStepGate n u (v j) ∧ outsideStepCap (expandedWideStepCap n) u (v j))
      (Classical.propDecidable _)
      (leftBilinearWeight n i*w j*residueWindowPair n u (v j) 0 (n/u) (p j) (s j)) 0

def outsideExpandedAfterProperPower (n : ℕ) : ℂ :=
  outsideExpandedFrom n (lowPrimeItems n) rightLowWaveStep
    (fun _ => 0) (rightLowWaveUpper n) rightLowWaveWeight +
  outsideExpandedFrom n (rightHighWaveItems n) rightHighWaveStep (rightHighWaveLower n)
    (fun j => n/rightHighWaveStep j) (rightHighWaveWeight n)

private theorem outside_proper_eq_gated (n : ℕ) :
    outsideExpandedFrom n (outsideProperPowerItems n) rightLowWaveStep
      (fun _ => 0) (rightLowWaveUpper n) rightLowWaveWeight = outsideProperPowerContribution n := by
  unfold outsideExpandedFrom outsideProperPowerContribution gatedWaveFamily outsideLeftItems
  rw [sum_filter]
  refine sum_congr rfl fun i hi => ?_
  let u := leftBilinearStep i
  have u0 : 0 < u := (mem_Icc.mp (bilateral_left_step_range hi)).1
  by_cases large : expandedWideStepCap n < u
  · rw [if_pos large]
    refine sum_congr rfl fun j hj => ?_
    have v0 : 0 < rightLowWaveStep j := (mem_Icc.mp (bilateral_right_low_step_range (mem_filter.mp hj).1)).1
    have out : outsideStepCap (expandedWideStepCap n) u (rightLowWaveStep j) :=
      fun h => (not_le_of_gt large) h.1
    dsimp only
    rw [← deep_wave_pair_eq_residue_window (n := n) u0 v0]
    by_cases pref : maximumStep n^2 < leftBilinearStep i * rightLowWaveStep j ∧
        (leftBilinearStep i).gcd (rightLowWaveStep j) ≤ maximumStep n
    · have gate : prefixStepGate n (leftBilinearStep i) (rightLowWaveStep j) ∧
          outsideStepCap (expandedWideStepCap n) (leftBilinearStep i) (rightLowWaveStep j) :=
        ⟨pref,out⟩
      rw [if_pos gate,if_pos pref]
    · have gate : ¬ (prefixStepGate n (leftBilinearStep i) (rightLowWaveStep j) ∧
          outsideStepCap (expandedWideStepCap n) (leftBilinearStep i) (rightLowWaveStep j)) :=
        fun h => pref h.1
      rw [if_neg gate,if_neg pref]
  · rw [if_neg large]
    refine sum_eq_zero fun j hj => ?_
    have vA : rightLowWaveStep j ≤ expandedWideStepCap n :=
      ((right_low_step_le_proved_medium_cap (mem_filter.mp hj).1).trans
        (old_step_cap_le_extended n)).trans (extended_step_cap_le_expanded n)
    have cut : ¬ (prefixStepGate n u (rightLowWaveStep j) ∧
        outsideStepCap (expandedWideStepCap n) u (rightLowWaveStep j)) :=
      fun h => h.2 ⟨le_of_not_gt large,vA⟩
    exact if_neg cut

