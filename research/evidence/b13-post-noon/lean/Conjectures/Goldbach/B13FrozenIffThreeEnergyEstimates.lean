    (steps : ∀ i ∈ I, g i ∈ Icc 1 A)
    {W : ℝ} (W0 : 0 ≤ W)
    (mass : ∀ u ∈ Icc 1 A, (∑ i ∈ I.filter (fun i => g i=u), ‖c i‖) ≤ W)
    {t : ℝ} (ht : |t-(a : ℝ)/q| ≤ (H : ℝ)/((q : ℝ)*n)) :
