  min (extendedWideStepCap n) (productLimit n/m)

def moderateHighFarRowAt (productLimit : ℕ → ℕ) (n : ℕ) (j : RightHighWaveIndex) : ℂ :=
  let m := rightHighWaveStep j
  ∑ g ∈ swappedHighDivisors n m, ∑ e ∈ g.divisors, ∑ k ∈ Icc 16 63,
    moderateHighFarWindow n m (rightHighWaveLower n j) g e k
      (moderateHighFarLower n m) (moderateHighFarUpperAt productLimit n m)

