    (Real.rpow_le_rpow_of_exponent_le (by exact_mod_cast hn) (by norm_num))

theorem long_right_low_upper_eq_div {n : ℕ} (hn : 0 < n) {j : RightLowWaveIndex}
    (hj : j ∈ longRightLowItems n) : rightLowWaveUpper n j = n/rightLowWaveStep j := by
  have h := mem_sigma.mp (long_right_low_subset n hj)
  have short : j.2 ≤ cutoffU n := (mem_Icc.mp h.2).2.trans (min_le_left _ _)
  have long : maximumStep n < j.2*j.1 := Nat.lt_of_not_ge (mem_filter.mp hj).2
  have cofactor : cofactorCap n < j.1 := by
    by_contra! low
    exact (not_le_of_gt long) (Nat.mul_le_mul short low)
  have cofactorR : (n : ℝ)^(111/256 : ℝ) ≤ j.1 := (Nat.lt_floor_add_one _).le.trans
    (by exact_mod_cast Nat.succ_le_of_lt cofactor)
  have nr : (0 : ℝ) < n := by exact_mod_cast hn
  have n1 : (1 : ℝ) ≤ n := by exact_mod_cast hn
  have power : (n : ℝ)^(1/3 : ℝ) ≤ j.1 :=
    (Real.rpow_le_rpow_of_exponent_le n1 (by norm_num : (1/3 : ℝ) ≤ 111/256)).trans cofactorR
  have bound : n/j.1 ≤ upperCut n := by
    apply Nat.le_floor
    refine Nat.cast_div_le.trans ((div_le_div_of_nonneg_left nr.le (by positivity) power).trans ?_)
    calc
      _ = (n : ℝ)^(1 : ℝ)/(n : ℝ)^(1/3 : ℝ) := by rw [Real.rpow_one]
      _ ≤ _ := by
        rw [← Real.rpow_sub nr,show (1 : ℝ)-1/3 = 2/3 by norm_num]
  unfold rightLowWaveUpper rightLowWaveStep
  rw [Nat.mul_comm j.2 j.1,← Nat.div_div_eq_div_mul, min_eq_right (Nat.div_le_div_right bound)]

theorem high_far_strip_product_cap_ge {n : ℕ} (hn : 0 < n) : n ≤ highFarStripProductCap n := by
  have n1 : (1 : ℝ) ≤ n := by exact_mod_cast hn
