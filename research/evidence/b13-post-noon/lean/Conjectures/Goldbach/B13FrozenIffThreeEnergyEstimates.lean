/- Source PEqualNP.Outside.L_b13_energy_windows -/
section

namespace B13EnergyWindows

open Finset

noncomputable section

def Saving (f : ℕ → ℂ) : Prop :=
  ∀ ε : ℝ, 0 < ε → ∃ N : ℕ, ∀ n : ℕ, N ≤ n → Even n → ‖f n‖ ≤ ε*(n : ℝ)

def energy (f : ℕ → ℂ) (n : ℕ) : ℝ := (‖f n‖ / (n : ℝ))^2

def average (f : ℕ → ℂ) (n H : ℕ) : ℝ :=
  (∑ j ∈ range (H+1), energy f (n+2*j)) / ((H+1 : ℕ) : ℝ)

def LongMean (f : ℕ → ℂ) : Prop :=
  ∀ ε : ℝ, 0 < ε → ∃ N : ℕ, ∀ n : ℕ, N ≤ n → Even n →
    average f n n ≤ ε

def WindowConcentration (f : ℕ → ℂ) : Prop :=
  ∀ ε : ℝ, 0 < ε → ∃ N : ℕ, ∀ n : ℕ, N ≤ n → Even n →
    average f n n.sqrt ≤ average f n n + ε

def PointConcentration (f : ℕ → ℂ) : Prop :=
  ∀ ε : ℝ, 0 < ε → ∃ N : ℕ, ∀ n : ℕ, N ≤ n → Even n →
    energy f n ≤ average f n n.sqrt + ε

theorem energy_nonneg (f : ℕ → ℂ) (n : ℕ) : 0 ≤ energy f n := sq_nonneg _

theorem average_nonneg (f : ℕ → ℂ) (n H : ℕ) : 0 ≤ average f n H := by
  exact div_nonneg (sum_nonneg (fun j _ => energy_nonneg f (n+2*j))) (by positivity)

theorem energy_small_of_saving {f : ℕ → ℂ} (h : Saving f) (ε : ℝ) (hε : 0 < ε) :
    ∃ N : ℕ, ∀ n : ℕ, N ≤ n → Even n → energy f n ≤ ε := by
  have sPos : 0 < Real.sqrt ε := Real.sqrt_pos.2 hε
  obtain ⟨M, hM⟩ := h (Real.sqrt ε) sPos
  refine ⟨max M 1, fun n hn he => ?_⟩
  have nPos : (0 : ℝ) < n := by exact_mod_cast (show 0 < n by omega)
  have ratio : ‖f n‖ / (n : ℝ) ≤ Real.sqrt ε :=
    (div_le_iff₀ nPos).2 (hM n (by omega) he)
  exact (pow_le_pow_left₀ (by positivity) ratio 2).trans_eq (Real.sq_sqrt hε.le)

theorem average_le_of_eventual_energy {f : ℕ → ℂ} {N n H : ℕ} {b : ℝ}
    (h : ∀ k : ℕ, N ≤ k → Even k → energy f k ≤ b) (hn : N ≤ n) (he : Even n) :
    average f n H ≤ b := by
  unfold average
  apply (div_le_iff₀ (show (0 : ℝ) < ((H+1 : ℕ) : ℝ) by positivity)).2
  calc
    _ ≤ ∑ _j ∈ range (H+1), b :=
      sum_le_sum (fun j _ => h (n+2*j) (by omega) (he.add ⟨j, by omega⟩))
    _ = _ := by rw [sum_const,card_range,nsmul_eq_mul,mul_comm]

theorem saving_iff_three_energy_bounds (f : ℕ → ℂ) :
    Saving f ↔ LongMean f ∧ WindowConcentration f ∧ PointConcentration f := by
  constructor
  · intro hf
    refine ⟨?_, ?_, ?_⟩ <;> intro ε hε <;>
      obtain ⟨N,hN⟩ := energy_small_of_saving hf ε hε <;>
      refine ⟨N, fun n hn he => ?_⟩
    · exact average_le_of_eventual_energy hN hn he
    · exact (average_le_of_eventual_energy hN hn he).trans
        (le_add_of_nonneg_left (average_nonneg f n n))
