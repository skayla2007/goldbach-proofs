    apply (ZMod.natCast_eq_zero_iff _ _).mp
    change φ (-(h*c)) = 0 at zero
    rw [map_neg,map_mul,val h,val c] at zero
    rw [Nat.cast_mul]
    exact neg_eq_zero.mp zero
