  have T0 := zero_le_one.trans T1
  have W0 : 0 ≤ W := by unfold W; positivity
  have B0 : 0 ≤ B := by unfold B; positivity
  have nR : (1 : ℝ) ≤ n := by exact_mod_cast n1
