      outsideExpandedFrom n (lowPrimeItems n) rightLowWaveStep
        (fun _ => 0) (rightLowWaveUpper n) rightLowWaveWeight +
      outsideExpandedFrom n (outsideProperPowerItems n) rightLowWaveStep
        (fun _ => 0) (rightLowWaveUpper n) rightLowWaveWeight := by
  unfold outsideExpandedFrom lowPrimeItems outsideProperPowerItems
  rw [← sum_add_distrib]
  refine sum_congr rfl fun i _ => ?_
  simp only [sum_filter,← sum_add_distrib]
  refine sum_congr rfl fun j _ => ?_
  by_cases d : j.1 ∣ n
  · simp [d]
  · by_cases p : j.1.Prime
    · simp [d,p]
    · by_cases q : IsPrimePow j.1
      · simp [d,p,q]
      · have z : vonMangoldt j.1 = 0 := vonMangoldt_eq_zero_iff.mpr q
