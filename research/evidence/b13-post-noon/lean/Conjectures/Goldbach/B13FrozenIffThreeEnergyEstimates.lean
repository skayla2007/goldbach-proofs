theorem divide_left_product_of_gcd {d a j : ℕ} (d0 : 0 < d) (dvd : d ∣ a*j) :
    let e := a.gcd d
    let k := d/e
    k ∣ j ∧ (a*j)/d = (a/e)*(j/k) := by
