  trimmedRightWindowContribution n J rightLowWaveStep (fun _ => 0) (rightLowWaveUpper n) rightLowWaveWeight

theorem trimmed_short_right_low_saving (J : ℕ → Finset RightLowWaveIndex)
    (base : ∀ n j, j ∈ J n → j ∈ rightLowWaveItems n ∧ rightLowWaveStep j ≤ maximumStep n) :
    saving (fun n => trimmedRightLowContribution n (J n)) := by
  apply trimmed_short_window_saving J rightLowWaveStep (fun _ _ => 0) rightLowWaveUpper
    (fun _ => rightLowWaveWeight) (fun n j h => bilateral_right_low_step_range (base n j h).1)
    (fun n j h => (base n j h).2) (fun _ _ _ => min_le_right _ _) _ (short_right_gated_wave_saving J base)
  intro n T T1 d q hq
  exact (sum_le_sum_of_subset_of_nonneg (filter_subset_filter _ (fun j hj => (base n j hj).1))
