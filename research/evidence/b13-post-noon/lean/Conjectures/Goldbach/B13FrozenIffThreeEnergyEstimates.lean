theorem outside_proper_power_contribution_saving : saving outsideProperPowerContribution := by
  intro ε he
  obtain ⟨D,D1,dBound⟩ := divisor_envelope_at_power 2496 (by decide)
  let C := (15/2)*D^10
  have limit : Tendsto (fun n : ℕ => (n : ℝ)^(-(1/192) : ℝ)) atTop (𝓝 0) :=
    (tendsto_rpow_neg_atTop (by norm_num : (0 : ℝ) < 1/192)).comp
      (tendsto_natCast_atTop_atTop (R := ℝ))
  have scaled : Tendsto (fun n : ℕ => C*(n : ℝ)^(-(1/192) : ℝ)) atTop (𝓝 0) := by
    simpa only [mul_zero] using tendsto_const_nhds.mul limit
  have estimate : ∀ᶠ n : ℕ in atTop, ‖outsideProperPowerContribution n‖ ≤ ε*(n : ℝ) := by
    filter_upwards [eventually_ge_atTop 2, eventually_log_budget_le_power (1/2496) (by norm_num),
      scaled.eventually_lt_const he] with n hn logb small
    have nr : (0 : ℝ) < n := by exact_mod_cast (show 0 < n by omega)
    have L0 : 0 ≤ logBudget n := zero_le_one.trans (one_le_logBudget n)
    let X := (n : ℝ)^(1/2496 : ℝ)
