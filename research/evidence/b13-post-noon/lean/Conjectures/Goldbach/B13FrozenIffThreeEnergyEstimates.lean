  have S : saving (fun n => F n + (-E n)) := saving_sum_two weil_near_right_ramp_broad_saving negCorrection
  have h : (fun n => F n + (-E n)) = weilNearRightRampKept := funext fun n => by
    rw [← sub_eq_add_neg,balance]
