  have c0 : 0 < c := Real.rpow_pos_of_pos N0 _
  have full := norm_gated_wave_family_le (n := n) (H := H) (M := M) (c := c)
    I J SL SR u l r v p s a b W0 W0 T0 c0 left right leL leR massL massR divisors suppL suppR
