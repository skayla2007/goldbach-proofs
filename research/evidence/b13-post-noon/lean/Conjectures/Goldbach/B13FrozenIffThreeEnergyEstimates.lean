    (left : ∀ n, 0 < n → ∀ i ∈ I n, leftBilinearStep i ≤ expandedWideStepCap n)
    (right : ∀ n, 0 < n → ∀ j ∈ J n, v j ∈ Icc 1 (expandedWideStepCap n))
