  have detCap (k : ℤ) (hk : k ∈ Icc (-K) K) : (s^2+t*k*(p : ℤ)).natAbs ≤ 4*p^3 := by
    have kabs : (↑|k| : ℝ) ≤ (K : ℝ) := by
