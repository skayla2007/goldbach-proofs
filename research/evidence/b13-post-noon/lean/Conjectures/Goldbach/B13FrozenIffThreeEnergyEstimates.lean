    obtain ⟨N,h⟩ := H (e/2) (by positivity) <;>
    obtain ⟨M,hm⟩ := outside_proper_power_contribution_saving (e/2) (by positivity) <;>
    refine ⟨max N M,fun n hn even => ?_⟩
