  · have g : u.gcd m ≤ thinHighGcdCap n := h.1.1.2.2.1
    rw [ite_eq_left h,ite_eq_left (And.intro h g)]
  · rw [ite_eq_right h,ite_eq_right (fun g => h g.1)]

