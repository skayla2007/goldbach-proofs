  unfold bandCoefficient upperBandWeight
  simp only [sum_filter, ← sum_sub_distrib]
  refine sum_congr rfl fun a _ => ?_
  by_cases hl : lo < a
  · by_cases hh : a ≤ hi
    · simp [hl, hh, not_lt_of_ge hh]
    · simp [hl, hh, lt_of_not_ge hh]
  · have nh : ¬ hi < a := fun h => hl (ordered.trans_lt h)
