  have inner₁ := bounded_outer_left_cut_saving farInnerGate J v p s w steps
    (fun n _ ht d q hq => mass n _ ht d q hq)
  have inner₂ := far_inner_left_divisor_cut_saving J v p s w steps
    (fun n _ ht d q hq => mass n _ ht d q hq)
  have outer := outside_target_cut_from_saving J (fun _ => v) p s w steps ends mass
  have corrections : saving (fun n => shortRightWindowTrimmingCorrection n (J n) v (p n) (s n) (w n)) :=
