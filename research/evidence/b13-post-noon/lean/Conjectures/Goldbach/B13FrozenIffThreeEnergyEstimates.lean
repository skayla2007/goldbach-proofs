    unfold rightHighWaveFactor rightRestrictedHighFactor restrictedVaughanFactor
      rightVaughanMangoldt rightVaughanMoebius
    rw [mangoldt_after_eq_prime_add_proper,mul_add]
  unfold rightHighWaveWeight rightHighPrimeWeight rightHighProperPowerWeight rightRestrictedHighWeight
  rw [split,ArithmeticFunction.add_apply,Complex.ofReal_add,mul_add]

