    change ‖(((μ x : ℝ) - (if x≤P then (μ x : ℝ) else 0) : ℝ) : ℂ)‖ ≤ 1
    by_cases cut : x ≤ P
    · simp [cut]
    · simpa [cut,moebiusComplex] using norm_moebiusComplex_le_one x
  simpa only [restrictedVaughanFactor,m,f,one_mul] using norm_convolution_apply_le bn m f zero_le_one
