  let w := swappedLowResidueTerm n m
  have step := mem_Icc.mp (bilateral_left_step_range (mem_filter.mp hr).1)
  have n1 : 1 ≤ n := step.1.trans step.2
  have mapsG : ∀ j ∈ I, d j ∈ G := fun _ hj => (mem_filter.mp hj).2.1
