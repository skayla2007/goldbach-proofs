  · simp only [if_neg h,mul_zero]

theorem weil_near_right_ramp_kept_saving : saving weilNearRightRampKept := by
  let F := weilNearRightRampSlice weilNearRightRows weilNearProductLower weilNearProductUpper
  let E := weilNearLeftCutFrom bilateralLeftWaveItems weilNearRightRows weilNearGroupGate
