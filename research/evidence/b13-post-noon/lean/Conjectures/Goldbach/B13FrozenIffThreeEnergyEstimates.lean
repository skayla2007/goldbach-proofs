  ∑ i ∈ I, ∑ j ∈ J, if D < (u i).gcd (v j) then
    a i * b j * productStepDeepIntegral n (u i) (v j) (l i) (r i) (p j) (s j) else 0

private def divPair (n e : ℕ) {α β : Type*} (I : Finset α) (J : Finset β)
