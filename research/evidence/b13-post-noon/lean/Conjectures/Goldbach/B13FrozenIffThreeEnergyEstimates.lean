    restrictedMangoldtAfter P keep

def rightRestrictedHighFactor (n : ℕ) := restrictedVaughanFactor (rightVaughanCut n)

def rightRestrictedHighWeight (n : ℕ) (keep : ℕ → Prop) (j : RightHighWaveIndex) : ℂ :=
  -(μ j.1 : ℂ)*(rightRestrictedHighFactor n keep j.2.2 : ℂ)

def rightHighPrimeWeight (n : ℕ) := rightRestrictedHighWeight n Nat.Prime

def rightHighProperPowerWeight (n : ℕ) :=
  rightRestrictedHighWeight n (fun b => ¬b.Prime ∧ IsPrimePow b)

private theorem restricted_mangoldt_positive (P b : ℕ) (keep : ℕ → Prop)
    (h : P<b ∧ keep b) : restrictedMangoldtAfter P keep b = vonMangoldt b := by
  simp only [restrictedMangoldtAfter,ArithmeticFunction.coe_mk,if_pos h]

private theorem restricted_mangoldt_zero (P b : ℕ) (keep : ℕ → Prop)
    (h : ¬(P<b ∧ keep b)) : restrictedMangoldtAfter P keep b = 0 := by
  simp only [restrictedMangoldtAfter,ArithmeticFunction.coe_mk,if_neg h]

theorem mangoldt_after_eq_prime_add_proper (P : ℕ) :
    vonMangoldt - truncateArithmetic vonMangoldt P =
      restrictedMangoldtAfter P Nat.Prime +
      restrictedMangoldtAfter P (fun b => ¬b.Prime ∧ IsPrimePow b) := by
  apply ArithmeticFunction.ext
  intro b
  let proper (x : ℕ) : Prop := ¬x.Prime ∧ IsPrimePow x
  change vonMangoldt b-(if b≤P then vonMangoldt b else 0) =
    restrictedMangoldtAfter P Nat.Prime b + restrictedMangoldtAfter P proper b
  by_cases h : b ≤ P
  · rw [if_pos h,sub_self,restricted_mangoldt_zero P b Nat.Prime (fun h' => (not_lt_of_ge h) h'.1),
      restricted_mangoldt_zero P b proper (fun h' => (not_lt_of_ge h) h'.1),add_zero]
  · have above := lt_of_not_ge h
    rw [if_neg h,sub_zero]
    by_cases p : b.Prime
    · rw [restricted_mangoldt_positive P b Nat.Prime ⟨above,p⟩,
        restricted_mangoldt_zero P b proper (fun pp => pp.2.1 p),add_zero]
    · rw [restricted_mangoldt_zero P b Nat.Prime (fun pp => p pp.2),zero_add]
      by_cases pp : IsPrimePow b
      · rw [restricted_mangoldt_positive P b proper ⟨above,p,pp⟩]
      · rw [restricted_mangoldt_zero P b proper (fun both => pp both.2.2),vonMangoldt_eq_zero_iff.mpr pp]

