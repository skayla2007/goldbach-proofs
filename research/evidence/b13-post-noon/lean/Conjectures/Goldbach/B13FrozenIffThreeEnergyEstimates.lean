    Squarefree (rightLowWaveStep j) := by
  have h := mem_sigma.mp (long_right_low_subset n hj)
  have dj : j.2 < j.1 :=
    ((mem_Icc.mp h.2).2.trans (min_le_left _ _)).trans_lt (mem_Ioc.mp h.1).1
  have prime := (mem_filter.mp (mem_filter.mp hj).1).2.1
  have dc : j.2.Coprime j.1 := ((Nat.Prime.coprime_iff_not_dvd prime).mpr (fun div =>
    (not_le_of_gt dj) (Nat.le_of_dvd (mem_Icc.mp h.2).1 div))).symm
  have mu : μ j.2 ≠ 0 := by
    intro zero
    exact weight (by simp [rightLowWaveWeight,zero])
  exact (Nat.squarefree_mul dc).mpr ⟨(moebius_ne_zero_iff_squarefree).mp mu,prime.squarefree⟩

theorem long_right_low_square_kept_of_ne_zero {n : ℕ} (hn : 0 < n) {j : RightLowWaveIndex}
    (hj : j ∈ longRightLowItems n) (weight : rightLowWaveWeight j ≠ 0) :
    stepWithoutLargeSquare n (rightLowWaveStep j) := by
  intro excluded
  obtain ⟨d,hd,sq⟩ := (mem_filter.mp excluded).2
