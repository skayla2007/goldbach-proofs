def rightStepIsShort (n : ℕ) (j : RightLowWaveIndex) : Prop := rightLowWaveStep j ≤ maximumStep n

def shortRightLowItems (n : ℕ) : Finset RightLowWaveIndex :=
  (lowPrimeItems n).filter (rightStepIsShort n)

def longRightLowItems (n : ℕ) : Finset RightLowWaveIndex :=
  (lowPrimeItems n).filter (fun j => ¬rightStepIsShort n j)

private theorem far_inner_thin_split_right (n : ℕ) {κ : Type} (J : Finset κ)
    (v p s : κ → ℕ) (w : κ → ℂ) (keep : κ → Prop) :
    farInnerThinFrom n J v p s w =
      farInnerThinFrom n (J.filter keep) v p s w +
      farInnerThinFrom n (J.filter (fun j => ¬keep j)) v p s w := by
  have pos : expandedWaveItems n (J.filter keep) v = (expandedWaveItems n J v).filter keep := by
    ext j
    simp only [expandedWaveItems,mem_filter]
    tauto
  have neg : expandedWaveItems n (J.filter (fun j => ¬keep j)) v =
      (expandedWaveItems n J v).filter (fun j => ¬keep j) := by
    ext j
    simp only [expandedWaveItems,mem_filter]
    tauto
  unfold farInnerThinFrom
  rw [pos,neg]
  unfold rawWavePairSum
  rw [← sum_add_distrib]
  refine sum_congr rfl fun i _ => ?_
  exact (sum_filter_add_sum_filter_not _ keep _).symm

