      have aCap : i.1 ≤ primeHyperbolaFactorFloor n 32 :=
        ((mem_Ioc.mp fac).2.trans (min_le_right _ _)).trans
          (prime_hyperbola_factor_floor_mono n1 (Nat.succ_le_succ (mem_Icc.mp hk).2))
      have base : i ∈ I := mem_filter.mpr ⟨left,dG,by rw [rel]; exact lo,by rw [rel]; exact up,aCap⟩
      exact mem_filter.mpr ⟨mem_filter.mpr ⟨mem_filter.mpr ⟨base,gg⟩,ee⟩,fac⟩
    · intro hi
      obtain ⟨hi₂,fac⟩ := mem_filter.mp hi
      obtain ⟨hi₁,ee⟩ := mem_filter.mp hi₂
      obtain ⟨hi₀,gg⟩ := mem_filter.mp hi₁
      obtain ⟨left,_,lo,up,_⟩ := mem_filter.mp hi₀
      have rel : (leftBilinearStep i).gcd m=g := gg
