  rw [restricted_mangoldt_zero P x.2 _ ng,mul_zero]

def highHasLargeProperFactor (n : ℕ) (j : RightHighWaveIndex) : Prop :=
  ∃ b : ℕ, b ∣ j.2.2 ∧ rightVaughanCut n < b ∧ ¬b.Prime ∧ IsPrimePow b

