theorem norm_deepStepIntegral_le (n threshold : ℕ) (items : Finset (ℕ × ℕ))
    (taken : items ⊆ shortStepAtoms n) (nLower : 2 ≤ n) (width : 4 * cutoffH n * maximumStep n ≤ n)
    {T : ℝ} (TLower : 1 ≤ T) (divisorBound : ∀ m ≤ n, (m.divisors.card : ℝ) ≤ T) :
    ‖deepStepIntegral n threshold items‖ ≤ totalConstant * finalScale n T := by
  let A := T ^ 2 * logBudget n
  let W := T * logBudget n
  have nPositive : 0 < n := by omega
  have TNonnegative : 0 ≤ T := zero_le_one.trans TLower
  have BNonnegative : 0 ≤ logBudget n := zero_le_one.trans (one_le_logBudget n)
  have ANonnegative : 0 ≤ A := mul_nonneg (sq_nonneg _) BNonnegative
  have WNonnegative : 0 ≤ W := mul_nonneg TNonnegative BNonnegative
  have aBound (m : ℕ) (membership : m ∈ range (n + 1)) : ‖lowCoefficients n m‖ ≤ A := by
    have mBound : m ≤ n := Nat.le_of_lt_succ (mem_range.mp membership)
    unfold lowCoefficients A
    rw [Complex.norm_real, Real.norm_eq_abs]
    exact (abs_lowBandCoefficient_le (cutoffU n) (lowCut n) m n mBound nPositive).trans
      (mul_le_mul (pow_le_pow_left₀ (Nat.cast_nonneg _) (divisorBound m mBound) 2)
        (log_le_logBudget nPositive le_rfl) (Real.log_nonneg (by exact_mod_cast nPositive)) (sq_nonneg _))
  have wBound := atomWeight_bound n items taken nPositive TNonnegative divisorBound
  have far := (norm_outsidePairIntegral_le n threshold items taken nPositive (outsideScale_positive n nPositive)
    ANonnegative WNonnegative aBound wBound).trans (outside_budget_le n nPositive TLower)
  have smooth := (norm_nearPair_replacement_le n threshold items taken nPositive ANonnegative TNonnegative aBound divisorBound wBound).trans
    (smoothing_budget_le n nPositive TLower)
  have primitive := (norm_smoothedNearPair_sub_primitive_le n threshold items taken nPositive TNonnegative divisorBound wBound).trans
    (primitive_replacement_budget_le n nLower TLower)
  have main : ‖primitiveNearPair n threshold items‖ ≤ (10240000 * gcdSeriesConstant) * finalScale n T :=
    (norm_primitiveNearPair_le n threshold items taken nLower TNonnegative divisorBound).trans_eq (by unfold finalScale; ring)
  have approxNorm (x y : ℂ) : ‖x‖ ≤ ‖x - y‖ + ‖y‖ := by
    simpa only [sub_add_cancel] using norm_add_le (x - y) y
  rw [deepStepIntegral_split n threshold items taken nPositive width]
  have triangle := norm_add_le (outsidePairIntegral n threshold items) (exactNearPair n threshold items)
  have first := approxNorm (exactNearPair n threshold items) (smoothedNearPair n threshold items)
  have second := approxNorm (smoothedNearPair n threshold items) (primitiveNearPair n threshold items)
  unfold totalConstant
  linarith only [triangle, first, second, far, smooth, primitive, main]

theorem deepStepIntegral_eventually (e : ℝ) (ePositive : 0 < e) :
    ∃ N : ℕ, ∀ n : ℕ, N ≤ n → ∀ (threshold : ℕ) (items : Finset (ℕ × ℕ)),
