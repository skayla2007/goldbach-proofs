    (hi : i ∈ bilateralLeftWaveItems n) (hj : j ∈ J) (base : j ∈ rightHighWaveItems n) :
    (j ∈ widerHighRowsWithin n J ∧ i ∈ moderateHighFarRowItemsAt C n (rightHighWaveStep j)) ↔
      (leftBilinearStep i ≤ expandedWideStepCap n ∧ rightHighWaveStep j ≤ expandedWideStepCap n) ∧
        boundedOuterLeftKeptGate (middleLowProductGateAt C shortLowModulusCap widerLowFarModulusCap true)
          n (leftBilinearStep i) (rightHighWaveStep j) ∧
        rightHighWaveLower n j < n/rightHighWaveStep j ∧
        (leftBilinearStep i).gcd (rightHighWaveStep j) ∣ n := by
  let u := leftBilinearStep i
  let v := rightHighWaveStep j
  obtain ⟨v0,vn⟩ := mem_Icc.mp (bilateral_right_high_step_range base)
  have n0 : 0 < n := v0.trans vn
  have n1 : (1 : ℝ) ≤ n := by exact_mod_cast n0
  have maxMod : widerLowFarModulusCap n ≤ extendedWideStepCap n :=
    Nat.floor_mono (Real.rpow_le_rpow_of_exponent_le n1 (by norm_num : (535/1024 : ℝ) ≤ 21/32))
  have thinN : thinHighProductCap n ≤ n := Nat.floor_le_of_le
    (Real.rpow_le_self_of_one_le n1 (by norm_num : (8191/8192 : ℝ) ≤ 1))
  constructor
  · rintro ⟨row,col⟩
    obtain ⟨_,vl,vu,char,hit⟩ := mem_filter.mp (mem_filter.mp row).1
    obtain ⟨_,gc,lo,up⟩ := mem_filter.mp col
    obtain ⟨div,gs,gm,_⟩ := mem_filter.mp gc
    have uCap : u ≤ extendedWideStepCap n := up.trans (min_le_left _ _)
    have p : maximumStep n^2 < u*v := (Nat.div_lt_iff_lt_mul v0).mp
      (((le_max_left _ _).trans (le_max_right _ _)).trans_lt ((le_max_left _ _).trans_lt lo))
    have far : 2*n < u*v := (Nat.div_lt_iff_lt_mul v0).mp ((le_max_right _ _).trans_lt lo)
    have thin : thinHighProductCap n < u*v := (thinN.trans (by omega : n ≤ 2*n)).trans_lt far
    have product : u*v ≤ C n := (Nat.le_div_iff_mul_le v0).mp (up.trans (min_le_right _ _))
    exact ⟨⟨uCap.trans (extended_step_cap_le_expanded n),vu.trans (maxMod.trans (extended_step_cap_le_expanded n))⟩,
      ⟨⟨uCap,vl,vu,⟨p,gm⟩,product,fun _ => far⟩,thin,gs,char⟩,hit,(Nat.mem_divisors.mp div).1⟩
  · rintro ⟨_,⟨⟨uCap,vl,vu,p,prod,far⟩,thin,gs,char⟩,hit,div⟩
    have row : j ∈ widerHighFarRows n := mem_filter.mpr ⟨base,vl,vu,char,hit⟩
    have gc : u.gcd v ∈ swappedHighDivisors n v :=
      mem_filter.mpr ⟨Nat.mem_divisors.mpr ⟨div,n0.ne'⟩,gs,p.2,Nat.gcd_dvd_right _ _⟩
    have minU : leftMediumCap n < u := (mem_filter.mp (mem_filter.mp hi).1).2
    have lo : moderateHighFarLower n v < u := max_lt
      (max_lt minU (max_lt ((Nat.div_lt_iff_lt_mul v0).mpr p.1)
        ((Nat.div_lt_iff_lt_mul v0).mpr ((thin_high_product_cap_ge_old n).trans_lt thin))))
      ((Nat.div_lt_iff_lt_mul v0).mpr (far rfl))
    have up : u ≤ moderateHighFarUpperAt C n v := le_min uCap ((Nat.le_div_iff_mul_le v0).mpr prod)
    exact ⟨mem_filter.mpr ⟨row,hj⟩,mem_filter.mpr ⟨hi,gc,lo,up⟩⟩

theorem wider_high_kept_eq_band_at (C : ℕ → ℕ) (n : ℕ) (J : Finset RightHighWaveIndex)
    (w : RightHighWaveIndex → ℂ) (sub : J ⊆ rightHighWaveItems n) :
    widerHighFarResidueSliceAt C n J w =
      boundedOuterLeftKeptFrom (middleLowProductGateAt C shortLowModulusCap widerLowFarModulusCap true)
        n J rightHighWaveStep (rightHighWaveLower n) (fun j => n/rightHighWaveStep j) w := by
  let X := bilateralLeftWaveItems n
  let R := widerHighRowsWithin n J
  let u := leftBilinearStep
  let v := rightHighWaveStep
  let p := rightHighWaveLower n
  let Q (j : RightHighWaveIndex) := moderateHighFarRowItemsAt C n (v j)
  let F := middleLowProductGateAt C shortLowModulusCap widerLowFarModulusCap true
  let G (i : ℕ × ℕ) (j : RightHighWaveIndex) :=
    (u i ≤ expandedWideStepCap n ∧ v j ≤ expandedWideStepCap n) ∧ boundedOuterLeftKeptGate F n (u i) (v j)
  let V (i : ℕ × ℕ) (j : RightHighWaveIndex) := leftBilinearWeight n i*w j*
    (pairResidueError n (u i) (v j) 0 (n/u i) (p j) (n/v j) : ℂ)
  have lhs : widerHighFarResidueSliceAt C n J w =
      ∑ j ∈ J, ∑ i ∈ X, if j ∈ R ∧ i ∈ Q j then V i j else 0 := by
    unfold widerHighFarResidueSliceAt
    have subset : R ⊆ J := fun j hj => (mem_filter.mp hj).2
    have inner (j : RightHighWaveIndex) : Q j ⊆ X := filter_subset _ _
    have point (j : RightHighWaveIndex) (hj : j ∈ R) :
        w j*moderateHighFarRowAt C n j = ∑ i ∈ Q j, V i j := by
      rw [wider_high_far_row_eq_selected_at C (mem_filter.mp hj).1,mul_sum]
      refine sum_congr rfl fun i _ => ?_
      unfold V u v p
      ring
    calc
      _ = ∑ j ∈ R, ∑ i ∈ Q j, V i j := sum_congr rfl point
      _ = _ := by
        rw [expand_outer_index_b13m326 subset]
        refine sum_congr rfl fun j _ => ?_
        by_cases hj : j ∈ R
        · rw [ite_eq_left hj,expand_outer_index_b13m326 (inner j)]
          refine sum_congr rfl fun i _ => ?_
          by_cases h : i ∈ Q j
          · rw [ite_eq_left h,ite_eq_left (And.intro hj h)]
          · rw [ite_eq_right h,ite_eq_right (fun hx : j ∈ R ∧ i ∈ Q j => h hx.2)]
        · simp [hj]
  have rhs : boundedOuterLeftKeptFrom F n J v p (fun j => n/v j) w =
      ∑ i ∈ X, ∑ j ∈ J, if G i j then V i j else 0 := by
    unfold boundedOuterLeftKeptFrom expandedWaveItems
    simp_rw [sum_filter]
    refine sum_congr rfl fun i _ => ?_
    by_cases hu : u i ≤ expandedWideStepCap n
    · have h' : leftBilinearStep i ≤ expandedWideStepCap n := hu
      rw [ite_eq_left h']
      refine sum_congr rfl fun j _ => ?_
      by_cases hv : v j ≤ expandedWideStepCap n <;> simp [hu,hv,G,V,u]
    · simp [hu,G,V,u]
  change _ = boundedOuterLeftKeptFrom F n J v p (fun j => n/v j) w
  rw [lhs,rhs,sum_comm (s := J) (t := X)]
  refine sum_congr rfl fun i hi => sum_congr rfl fun j hj => ?_
  have eq := wider_high_row_col_membership_at C hi hj (sub hj)
  by_cases good : G i j
  · by_cases interval : p j < n/v j
    · by_cases gcd : (u i).gcd (v j) ∣ n
      · have yes : j ∈ R ∧ i ∈ Q j := eq.mpr ⟨good.1,good.2,interval,gcd⟩
        rw [ite_eq_left yes,ite_eq_left good]
      · have no : ¬(j ∈ R ∧ i ∈ Q j) := fun z => gcd (eq.mp z).2.2.2
        rw [ite_eq_right no,ite_eq_left good]
        simp [V,pairResidueError,gcd]
    · have no : ¬(j ∈ R ∧ i ∈ Q j) := fun z => interval (eq.mp z).2.2.1
      rw [ite_eq_right no,ite_eq_left good]
      have z := pair_residue_error_eq_zero_of_right_interval_empty (n := n) (l := 0) (r := n/u i)
        (mem_Icc.mp (bilateral_left_step_range hi)).1
        (mem_Icc.mp (bilateral_right_high_step_range (sub hj))).1 (not_lt.mp interval)
      change pairResidueError n (u i) (v j) 0 (n/u i) (p j) (n/v j)=0 at z
      simp [V,z]
  · have no : ¬(j ∈ R ∧ i ∈ Q j) := fun z => good ⟨(eq.mp z).1,(eq.mp z).2.1⟩
    rw [ite_eq_right no,ite_eq_right good]

theorem wider_high_kept_saving_at (C : ℕ → ℕ) (cap : ∀ n, C n ≤ expandedHyperbolaProductCap n)
    (J : ℕ → Finset RightHighWaveIndex) (w : ℕ → RightHighWaveIndex → ℂ) (sub : ∀ n, J n ⊆ rightHighWaveItems n)
    (weights : ∀ n, ∀ {T : ℝ}, 1 ≤ T → (∀ z ≤ n, (z.divisors.card : ℝ) ≤ T) →
      ∀ q ∈ Icc 1 n, (∑ j ∈ (J n).filter (fun j => rightHighWaveStep j=q), ‖w n j‖) ≤ T^3*logBudget n) :
    saving (fun n =>
      boundedOuterLeftKeptFrom (middleLowProductGateAt C shortLowModulusCap widerLowFarModulusCap true)
        n (J n) rightHighWaveStep (rightHighWaveLower n) (fun j => n/rightHighWaveStep j) (w n)) := by
  have save := wider_high_far_residue_saving_at C cap J w weights
  simpa only [wider_high_kept_eq_band_at C _ _ _ (sub _)] using save

end

