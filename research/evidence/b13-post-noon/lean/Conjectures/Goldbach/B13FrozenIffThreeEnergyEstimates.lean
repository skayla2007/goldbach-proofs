    (fun i hi => (wave_cap ..).trans ((by exact_mod_cast endpoints i (mem_filter.mp hi).1 :
      (r i : ℝ) ≤ ((n/g i : ℕ) : ℝ)).trans Nat.cast_div_le))
    (fun _ _ => by positivity) (fun u hu => mass u (mem_filter.mp hu).1)
