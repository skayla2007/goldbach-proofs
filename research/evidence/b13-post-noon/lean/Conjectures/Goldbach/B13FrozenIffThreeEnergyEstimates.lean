          linarith only [powLe]
    have norm : ((s^2+t*k*(p : ℤ)).natAbs : ℝ) ≤ 4*(p : ℝ)^3 := by
      simpa only [Nat.cast_natAbs,Int.cast_abs,Int.cast_add,Int.cast_pow,Int.cast_mul,Int.cast_natCast,P] using main
