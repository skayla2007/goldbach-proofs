  change outsideExpandedAgainst n (bilateralLeftWaveItems n) J v p s w = _
  rw [outside_expanded_against_left_split n _ _ _ _ _ _
    (fun i => targetDivisorKept n (leftBilinearStep i))]
  rw [outside_expanded_against_right_split n
    ((bilateralLeftWaveItems n).filter (fun i => targetDivisorKept n (leftBilinearStep i)))
    J v p s w (fun j => targetDivisorKept n (v j))]
  unfold outsideTargetKeptFrom outsideTargetCutFrom
  abel

theorem card_ordinary_frequency_range_le (n : ℕ) {T : ℝ} (T1 : 1 ≤ T) :
    (((Icc 1 n).card : ℕ) : ℝ) ≤ (n : ℝ)^(1-(0 : ℝ))*T := by
  simpa [Nat.card_Icc] using le_mul_of_one_le_right (Nat.cast_nonneg (α := ℝ) n) T1

theorem outside_target_cut_from_saving {κ : Type} (J : ℕ → Finset κ)
    (v p s : ℕ → κ → ℕ) (w : ℕ → κ → ℂ)
    (rStep : ∀ n j, j ∈ J n → v n j ∈ Icc 1 n)
    (rEnd : ∀ n j, j ∈ J n → s n j ≤ n/v n j)
    (rMass : ∀ n : ℕ, ∀ T : ℝ, 1 ≤ T → (∀ m ≤ n, (m.divisors.card : ℝ) ≤ T) →
      ∀ q ∈ Icc 1 n, (∑ j ∈ (J n).filter (fun j => v n j=q), ‖w n j‖) ≤ T^3*logBudget n) :
    saving (fun n => outsideTargetCutFrom n (J n) (v n) (p n) (s n) (w n)) := by
  let SL (n : ℕ) := Icc 1 n
  let ST (n : ℕ) := targetDivisorSupport n (sparseTargetDivisorCap n)
  let IL (n : ℕ) := (bilateralLeftWaveItems n).filter (fun i => ¬targetDivisorKept n (leftBilinearStep i))
  let IK (n : ℕ) := (bilateralLeftWaveItems n).filter (fun i => targetDivisorKept n (leftBilinearStep i))
  let JT (n : ℕ) := (J n).filter (fun j => ¬targetDivisorKept n (v n j))
  have basic : ∀ n T, 2 ≤ n → 1 ≤ (T : ℝ) → (n.divisors.card : ℝ) ≤ T →
