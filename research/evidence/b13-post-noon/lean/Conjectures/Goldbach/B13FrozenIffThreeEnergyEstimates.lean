      (fun m => (bandCoefficient n L V weight m : ℂ)) t =
    ∑ b ∈ Ioc (cutoffU n) n, ∑ d ∈ Icc 1 (min (cutoffU n) (n / b)),
      (-(μ d : ℂ)) * (weight b : ℂ) *
        ∑ k ∈ Ioc (L / d) (min (V / d) (n / (d * b))),
          phase (((d * b * k : ℕ) : ℝ) * t) := by
