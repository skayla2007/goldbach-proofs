private theorem indicator_eq_interval_residue_count {p : ℕ} [NeZero p] {a b j : ℤ}
    (ha : 0 ≤ a) (hb : b ≤ p) (hj : j ∈ Ioc (0 : ℤ) (p : ℤ)) :
