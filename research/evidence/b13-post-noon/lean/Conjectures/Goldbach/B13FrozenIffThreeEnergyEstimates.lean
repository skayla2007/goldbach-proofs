def symmetricInnerFamily (n : ℕ) {κ : Type} (I : Finset (ℕ × ℕ)) (J : Finset κ)
    (v p : κ → ℕ) (a : ℕ × ℕ → ℂ) (w : κ → ℂ) (gate : ℕ → ℕ → Prop)
    (kernel : ℕ → ℕ → ℕ → ℝ) : ℂ :=
  ∑ i ∈ I,∑ j ∈ J,
    let u := leftBilinearStep i
    let q := v j
    if farInnerThinGate n u q ∧ gate u q then a i*w j*(kernel u q (p j) : ℂ) else 0

def symmetricInnerCorrection (n : ℕ) {κ : Type} (I : Finset (ℕ × ℕ)) (J : Finset κ)
    (v p : κ → ℕ) (a : ℕ × ℕ → ℂ) (w : κ → ℂ) (gate : ℕ → ℕ → Prop) : ℂ :=
  symmetricInnerFamily n I J v p a w gate
    (fun u q l => pairResidueError n u q 0 (n/u) l (n/q)-symmetricResidueError n u q l)

theorem selected_inner_eq_symmetric (n : ℕ) {κ : Type} (I : Finset (ℕ × ℕ)) (J : Finset κ)
    (v p : κ → ℕ) (a : ℕ × ℕ → ℂ) (w : κ → ℂ) (gate : ℕ → ℕ → Prop) :
    selectedInnerResidue n I J v p (fun j => n/v j) a w gate =
      symmetricInnerFamily n I J v p a w gate (symmetricResidueError n) +
      symmetricInnerCorrection n I J v p a w gate := by
  unfold selectedInnerResidue symmetricInnerCorrection symmetricInnerFamily
  rw [← sum_add_distrib]
  refine sum_congr rfl fun i _ => ?_
  rw [← sum_add_distrib]
  refine sum_congr rfl fun j _ => ?_
  dsimp only
  split_ifs <;> push_cast <;> ring

private theorem inverse_step_mass_le {κ : Type} (A : ℕ) (I : Finset κ)
    (u : κ → ℕ) (w : κ → ℂ) {W : ℝ} (W0 : 0 ≤ W)
    (steps : ∀ i ∈ I, u i ∈ Icc 1 A)
    (mass : ∀ m ∈ Icc 1 A, (∑ i ∈ I.filter (fun i => u i=m), ‖w i‖) ≤ W) :
    (∑ i ∈ I, ‖w i‖*(u i : ℝ)⁻¹) ≤ W*(1+Real.log A) := by
  have h := divisible_inverse_step_mass_le 1 A 1 (by decide) I u w W0 steps mass
  simpa only [divisibleStepMass,Nat.cast_one,one_div,div_one,one_mul,one_dvd,filter_true] using h

theorem norm_symmetric_inner_correction_le {n A : ℕ} (A0 : 0 < A) {κ : Type}
    (I : Finset (ℕ × ℕ)) (J : Finset κ)
    (v p : κ → ℕ) (a : ℕ × ℕ → ℂ) (w : κ → ℂ) (gate : ℕ → ℕ → Prop)
    {W : ℝ} (W0 : 0 ≤ W)
    (left : ∀ i ∈ I, leftBilinearStep i ∈ Icc 1 A) (right : ∀ j ∈ J, v j ∈ Icc 1 A)
    (massL : ∀ m ∈ Icc 1 A, (∑ i ∈ I.filter (fun i => leftBilinearStep i=m), ‖a i‖) ≤ W)
    (massR : ∀ m ∈ Icc 1 A, (∑ j ∈ J.filter (fun j => v j=m), ‖w j‖) ≤ W) :
    ‖symmetricInnerCorrection n I J v p a w gate‖ ≤
      6*(thinHighGcdCap n : ℝ)*W^2*(A : ℝ)*(1+Real.log A) := by
  let L := 1+Real.log (A : ℝ)
  let C := 3*(thinHighGcdCap n : ℝ)
  let u := leftBilinearStep
  let u0 := ∑ i ∈ I, ‖a i‖
  let u1 := ∑ i ∈ I, ‖a i‖*(u i : ℝ)⁻¹
  let v0 := ∑ j ∈ J, ‖w j‖
  let v1 := ∑ j ∈ J, ‖w j‖*(v j : ℝ)⁻¹
  have U0 : u0 ≤ W*A := sum_norm_le_of_step_mass I u a left massL
  have V0 : v0 ≤ W*A := sum_norm_le_of_step_mass J v w right massR
  have U1 : u1 ≤ W*L := inverse_step_mass_le A I u a W0 left massL
  have V1 : v1 ≤ W*L := inverse_step_mass_le A J v w W0 right massR
  have L0 : 0 ≤ L := add_nonneg zero_le_one (Real.log_nonneg (by exact_mod_cast A0))
  unfold symmetricInnerCorrection symmetricInnerFamily
  dsimp only
  refine (norm_sum_le _ _).trans ((sum_le_sum fun i _ => norm_sum_le _ _).trans ?_)
  calc
    _ ≤ ∑ i ∈ I,∑ j ∈ J, C*(‖a i‖*‖w j‖*((u i : ℝ)⁻¹+(v j : ℝ)⁻¹)) := by
      refine sum_le_sum fun i hi => sum_le_sum fun j hj => ?_
      split_ifs with h
      · have cap : ((u i).gcd (v j) : ℝ) ≤ (thinHighGcdCap n : ℝ) := by
          exact_mod_cast h.1.1.2.2.1
        rw [norm_mul,norm_mul,Complex.norm_real,Real.norm_eq_abs]
        have b := abs_full_pair_residue_sub_symmetric_le (n := n) (p := p j)
          (mem_Icc.mp (left i hi)).1 (mem_Icc.mp (right j hj)).1
        calc
          _ ≤ ‖a i‖*‖w j‖*(3*((u i).gcd (v j) : ℝ)*((u i : ℝ)⁻¹+(v j : ℝ)⁻¹)) :=
            mul_le_mul_of_nonneg_left b (by positivity)
          _ = (3*((u i).gcd (v j) : ℝ))*(‖a i‖*‖w j‖*((u i : ℝ)⁻¹+(v j : ℝ)⁻¹)) := by ring
          _ ≤ _ := mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left cap (by norm_num))
            (by positivity)
      · rw [norm_zero]
        unfold C
        positivity
