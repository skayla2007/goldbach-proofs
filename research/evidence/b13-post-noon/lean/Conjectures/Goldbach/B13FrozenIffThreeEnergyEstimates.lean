section

namespace GoldbachTypeII13

open Finset
open DyadicMixedB4ArcGeometry
open scoped Classical

noncomputable section

def reducedRationalCenters (B : ℕ) : Finset (ℕ × ℕ) :=
  ((Icc 1 B) ×ˢ range (B+1)).filter (fun c => c.2 ≤ c.1 ∧ c.2.Coprime c.1)

theorem mem_reduced_rational_centers {B : ℕ} {c : ℕ × ℕ} :
    c ∈ reducedRationalCenters B ↔ 0 < c.1 ∧ c.1 ≤ B ∧ c.2 ≤ c.1 ∧ c.2.Coprime c.1 := by
  simp only [reducedRationalCenters,mem_filter,mem_product,mem_Icc,mem_range]
  omega

def rationalCenter (c : ℕ × ℕ) : ℝ := (c.2 : ℝ)/c.1

theorem reduced_rational_center_injective {q a r b : ℕ} (q0 : 0 < q) (r0 : 0 < r)
    (ac : a.Coprime q) (bc : b.Coprime r) (eq : (a : ℝ)/q = (b : ℝ)/r) : q=r ∧ a=b := by
  have eqn : a*r=b*q := by
    exact_mod_cast (div_eq_div_iff (by exact_mod_cast q0.ne' : (q : ℝ) ≠ 0)
      (by exact_mod_cast r0.ne' : (r : ℝ) ≠ 0)).mp eq
  have left : q∣a*r := eqn ▸ Nat.dvd_mul_left q b
  have right : r∣b*q := eqn.symm ▸ Nat.dvd_mul_left r a
  have d := Nat.dvd_antisymm (ac.symm.dvd_of_dvd_mul_left left) (bc.symm.dvd_of_dvd_mul_left right)
  subst r
  exact ⟨rfl,Nat.eq_of_mul_eq_mul_right q0 eqn⟩

def orbitLiftGcd (d k : ℕ) (c : ℕ × ℕ) : ℕ := d.gcd (c.2+c.1*k)

def orbitLiftDenominator (d k : ℕ) (c : ℕ × ℕ) : ℕ := d*c.1/orbitLiftGcd d k c

def orbitLiftNumerator (d k : ℕ) (c : ℕ × ℕ) : ℕ := (c.2+c.1*k)/orbitLiftGcd d k c

private theorem gcd_lift_numerator {a q d k : ℕ} (cop : a.Coprime q) :
    (a+q*k).gcd (d*q) = d.gcd (a+q*k) := by
  have Aq : (a+q*k).Coprime q := by simpa [Nat.coprime_iff_gcd_eq_one,Nat.gcd_add_mul_right_right] using cop
  have e : (a+q*k).gcd (d*q) ∣ d := by
    have h := Nat.gcd_dvd_right (a+q*k) (d*q)
    have copG := Aq.coprime_dvd_left (Nat.gcd_dvd_left (a+q*k) (d*q))
    exact copG.dvd_of_dvd_mul_right h
  apply Nat.dvd_antisymm
  · exact Nat.dvd_gcd e (Nat.gcd_dvd_left _ _)
  · exact Nat.dvd_gcd (Nat.gcd_dvd_right _ _) (dvd_mul_of_dvd_left (Nat.gcd_dvd_left _ _) _)

theorem orbit_lift_data {B d k : ℕ} (d0 : 0 < d) (hk : k < d) {c : ℕ × ℕ}
    (mem : c ∈ reducedRationalCenters B) :
    0 < orbitLiftDenominator d k c ∧ orbitLiftNumerator d k c ≤ orbitLiftDenominator d k c ∧
      (orbitLiftNumerator d k c).Coprime (orbitLiftDenominator d k c) ∧
      (orbitLiftDenominator d k c)*(orbitLiftGcd d k c) = d*c.1 ∧
      ((orbitLiftNumerator d k c : ℝ)/orbitLiftDenominator d k c) =
        (rationalCenter c+(k : ℝ))/d := by
  obtain ⟨q0,_,ab,cop⟩ := mem_reduced_rational_centers.mp mem
  let A := c.2+c.1*k
  let g := orbitLiftGcd d k c
  have gd : g ∣ d := Nat.gcd_dvd_left _ _
  have gA : g ∣ A := Nat.gcd_dvd_right _ _
  have gD : g ∣ d*c.1 := dvd_mul_of_dvd_left gd _
  have g0 : 0 < g := Nat.gcd_pos_of_pos_left _ d0
  have D0 : 0 < d*c.1 := Nat.mul_pos d0 q0
  have den0 : 0 < d*c.1/g := Nat.div_pos (Nat.le_of_dvd D0 gD) g0
  have numLe : A ≤ d*c.1 := by
    unfold A
    calc
      _ ≤ c.1*(k+1) := by rw [Nat.mul_succ]; omega
      _ ≤ c.1*d := Nat.mul_le_mul_left _ (Nat.succ_le_of_lt hk)
      _ = _ := Nat.mul_comm _ _
  have gEq : A.gcd (d*c.1)=g := gcd_lift_numerator cop
  have copLift : (A/g).Coprime (d*c.1/g) := by
    rw [← gEq]
    exact Nat.coprime_div_gcd_div_gcd (Nat.gcd_pos_of_pos_right A D0)
  refine ⟨den0,Nat.div_le_div_right numLe,copLift,Nat.div_mul_cancel gD,?_⟩
  have hDen : ((d*c.1/g : ℕ) : ℝ)*(g : ℝ) = (d : ℝ)*c.1 := by
    exact_mod_cast Nat.div_mul_cancel gD
  have hNum : ((A/g : ℕ) : ℝ)*(g : ℝ) = (c.2 : ℝ)+(c.1 : ℝ)*k := by
    have h := Nat.div_mul_cancel gA
    unfold A at h
    exact_mod_cast h
  change ((A/g : ℕ) : ℝ)/((d*c.1/g : ℕ) : ℝ) = ((c.2 : ℝ)/c.1+(k : ℝ))/d
  rw [← mul_div_mul_right _ _ (by exact_mod_cast g0.ne' : (g : ℝ) ≠ 0),hNum,hDen]
  have qR : (c.1 : ℝ) ≠ 0 := by exact_mod_cast q0.ne'
  have dR : (d : ℝ) ≠ 0 := by exact_mod_cast d0.ne'
  field_simp

def orbitCenterHit (n B H d k : ℕ) (t : ℝ) (c : ℕ × ℕ) : Prop :=
  orbitLiftDenominator d k c ≤ B ∧
    |(d : ℝ)*t-rationalCenter c| ≤ (H : ℝ)*(orbitLiftGcd d k c)/((n : ℝ)*c.1)

theorem orbit_lift_hit_iff {n B H d k : ℕ} (n0 : 0 < n) (d0 : 0 < d) (hk : k < d)
    {c : ℕ × ℕ} (mem : c ∈ reducedRationalCenters B) (t : ℝ) :
    orbitCenterHit n B H d k t c ↔
      orbitLiftDenominator d k c ≤ B ∧
        t+(k : ℝ)/d ∈ wideArc n H (orbitLiftDenominator d k c) (orbitLiftNumerator d k c) := by
  obtain ⟨r0,_,_,prod,eq⟩ := orbit_lift_data d0 hk mem
  have dR : (0 : ℝ) < d := by exact_mod_cast d0
  have rR : (0 : ℝ) < orbitLiftDenominator d k c := by exact_mod_cast r0
  have qR : (0 : ℝ) < c.1 := by exact_mod_cast (mem_reduced_rational_centers.mp mem).1
  have nR : (0 : ℝ) < n := by exact_mod_cast n0
  have lr : |t+(k : ℝ)/d-(orbitLiftNumerator d k c : ℝ)/orbitLiftDenominator d k c| * (d : ℝ) =
      |(d : ℝ)*t-rationalCenter c| := by
    calc
      _ = |(t+(k : ℝ)/d-(orbitLiftNumerator d k c : ℝ)/orbitLiftDenominator d k c)*(d : ℝ)| := by
        rw [abs_mul,abs_of_nonneg dR.le]
      _ = _ := by
        rw [eq]
        congr 1
        field_simp <;> ring
  have rr : ((H : ℝ)/((orbitLiftDenominator d k c : ℝ)*n))*(d : ℝ) =
      (H : ℝ)*(orbitLiftGcd d k c)/((n : ℝ)*c.1) := by
    have cast : (orbitLiftDenominator d k c : ℝ)*(orbitLiftGcd d k c : ℝ) = (d : ℝ)*c.1 := by
      exact_mod_cast prod
    apply (eq_div_iff (mul_ne_zero nR.ne' qR.ne')).mpr
    calc
      _ = ((H : ℝ)/((orbitLiftDenominator d k c : ℝ)*n))*(n : ℝ)*((d : ℝ)*c.1) := by ring
      _ = _ := by rw [← cast]; field_simp
  unfold orbitCenterHit wideArc
  change (_ ∧ _) ↔ (_ ∧ |t+_ - _| ≤ _)
  rw [← lr,← rr,mul_le_mul_iff_left₀ dR]

end

end GoldbachTypeII13

end

/- Source PEqualNP.Outside.L_b13_signed_wide_orbit_count -/
section

namespace GoldbachTypeII13

open Finset
open DyadicMixedB4DyadicPartition
open scoped Classical

noncomputable section

def nearbyRationalCenters (B : ℕ) (z epsilon : ℝ) : Finset (ℕ × ℕ) :=
  (reducedRationalCenters B).filter (fun c => |z-rationalCenter c| ≤ epsilon/(c.1 : ℝ))

private theorem reduced_rational_distance_lower {B : ℕ} {x y : ℕ × ℕ}
    (hx : x ∈ reducedRationalCenters B) (hy : y ∈ reducedRationalCenters B) (ne : x ≠ y) :
    1/((x.1 : ℝ)*y.1) ≤ |rationalCenter x-rationalCenter y| := by
  obtain ⟨x0,_,_,xc⟩ := mem_reduced_rational_centers.mp hx
  obtain ⟨y0,_,_,yc⟩ := mem_reduced_rational_centers.mp hy
  have X : (0 : ℝ) < x.1 := by exact_mod_cast x0
  have Y : (0 : ℝ) < y.1 := by exact_mod_cast y0
  have different : x.2*y.1 ≠ y.2*x.1 := by
    intro eq
    have same : (x.2 : ℝ)/x.1 = (y.2 : ℝ)/y.1 :=
      (div_eq_div_iff X.ne' Y.ne').mpr (by exact_mod_cast eq)
    obtain ⟨den,num⟩ := reduced_rational_center_injective x0 y0 xc yc same
    exact ne (Prod.ext den num)
  unfold rationalCenter
  have den : (0 : ℝ) < (x.1 : ℝ)*y.1 := mul_pos X Y
  rw [show (x.2 : ℝ)/x.1-(y.2 : ℝ)/y.1 = ((x.2 : ℝ)*y.1-(y.2 : ℝ)*x.1)/((x.1 : ℝ)*y.1) by field_simp,
    abs_div,abs_of_pos den,div_le_div_iff_of_pos_right den]
  rcases lt_or_gt_of_ne different with h | h
  · have hg : (x.2 : ℝ)*y.1+1 ≤ (y.2 : ℝ)*x.1 := by exact_mod_cast Nat.succ_le_of_lt h
    linarith only [hg,neg_le_abs ((x.2 : ℝ)*y.1-(y.2 : ℝ)*x.1)]
  · have hg : (y.2 : ℝ)*x.1+1 ≤ (x.2 : ℝ)*y.1 := by exact_mod_cast Nat.succ_le_of_lt h
    linarith only [hg,le_abs_self ((x.2 : ℝ)*y.1-(y.2 : ℝ)*x.1)]

private theorem card_dyadic_nearby_rational_centers_le {B k : ℕ} (z epsilon : ℝ)
    (eps0 : 0 ≤ epsilon) :
    (((nearbyRationalCenters B z epsilon).filter (fun c => Nat.log 2 c.1=k)).card : ℝ) ≤
      1+8*epsilon*(B : ℝ) := by
  let S := (nearbyRationalCenters B z epsilon).filter (fun c => Nat.log 2 c.1=k)
  by_cases some : S.Nonempty
  · let R := dyadicBase k
    have R0 : 0 < R := dyadicBase_positive k
    have r0 : (0 : ℝ) < R := by exact_mod_cast R0
    have center (c : ℕ × ℕ) (hc : c ∈ S) : c ∈ reducedRationalCenters B :=
      (mem_filter.mp (mem_filter.mp hc).1).1
    have band (c : ℕ × ℕ) (hc : c ∈ S) : R ≤ c.1 ∧ c.1 < 2*R :=
      mem_Ico.mp (mem_dyadicInterval (mem_reduced_rational_centers.mp (center c hc)).1 (mem_filter.mp hc).2)
    have RB : R ≤ B := by
      obtain ⟨c,hc⟩ := some
      exact (band c hc).1.trans (mem_reduced_rational_centers.mp (center c hc)).2.1
    let L := z-epsilon/(R : ℝ)
    let X (c : ℕ × ℕ) := 4*(R : ℝ)^2*(rationalCenter c-L)
    have dist (c : ℕ × ℕ) (hc : c ∈ S) :
        L ≤ rationalCenter c ∧ rationalCenter c ≤ z+epsilon/(R : ℝ) := by
      have qR : (0 : ℝ) < c.1 := by exact_mod_cast (mem_reduced_rational_centers.mp (center c hc)).1
      have radius : epsilon/(c.1 : ℝ) ≤ epsilon/(R : ℝ) :=
        div_le_div_of_nonneg_left eps0 r0 (by exact_mod_cast (band c hc).1)
      have h := abs_le.mp ((mem_filter.mp (mem_filter.mp hc).1).2.trans radius)
      unfold L
      constructor <;> linarith only [h.1,h.2]
    have X0 (c : ℕ × ℕ) (hc : c ∈ S) : 0 ≤ X c := by
      exact mul_nonneg (by positivity) (sub_nonneg.mpr (dist c hc).1)
    have Xtop (c : ℕ × ℕ) (hc : c ∈ S) : X c ≤ 8*epsilon*(R : ℝ) := by
      calc
        _ ≤ 4*(R : ℝ)^2*(2*epsilon/(R : ℝ)) := by
          apply mul_le_mul_of_nonneg_left _ (by positivity)
          unfold L
          linarith only [(dist c hc).2,show 2*epsilon/(R : ℝ)=2*(epsilon/(R : ℝ)) by ring]
        _ = _ := by field_simp; ring
    let f (c : ℕ × ℕ) := ⌊X c⌋₊
    have inc : S.card ≤ (range (⌊8*epsilon*(R : ℝ)⌋₊+1)).card := by
      apply card_le_card_of_injOn f
      · intro c hc
        exact mem_range.mpr (Nat.lt_succ_of_le (Nat.floor_mono (Xtop c hc)))
      · intro x hx y hy eq
        by_contra ne
        have spacing := reduced_rational_distance_lower (center x hx) (center y hy) ne
        have qx : (0 : ℝ) < x.1 := by exact_mod_cast (mem_reduced_rational_centers.mp (center x hx)).1
        have qy : (0 : ℝ) < y.1 := by exact_mod_cast (mem_reduced_rational_centers.mp (center y hy)).1
        have xhi : (x.1 : ℝ) ≤ 2*(R : ℝ) := by exact_mod_cast (band x hx).2.le
        have yhi : (y.1 : ℝ) ≤ 2*(R : ℝ) := by exact_mod_cast (band y hy).2.le
        have cap : (x.1 : ℝ)*y.1 ≤ 4*(R : ℝ)^2 :=
          (mul_le_mul xhi yhi qy.le (by positivity)).trans_eq (by ring)
        have sep : 1/(4*(R : ℝ)^2) ≤ |rationalCenter x-rationalCenter y| :=
          (div_le_div_of_nonneg_left zero_le_one (mul_pos qx qy) cap).trans spacing
        have xa := Nat.floor_le (X0 x hx)
        have ya := Nat.floor_le (X0 y hy)
        have xb := Nat.lt_floor_add_one (X x)
        have yb := Nat.lt_floor_add_one (X y)
        change ⌊X x⌋₊ = ⌊X y⌋₊ at eq
        rw [eq] at xa xb
        have small : |X x-X y| < 1 := abs_lt.mpr ⟨by linarith only [xa,yb],by linarith only [xb,ya]⟩
        have large : 1 ≤ |X x-X y| := by
          change 1 ≤ |4*(R : ℝ)^2*(rationalCenter x-L)-4*(R : ℝ)^2*(rationalCenter y-L)|
          rw [← mul_sub,sub_sub_sub_cancel_right,abs_mul,abs_of_nonneg (by positivity : 0 ≤ 4*(R : ℝ)^2)]
          apply (div_le_iff₀ (by positivity : 0 < 4*(R : ℝ)^2)).mp at sep
          simpa only [mul_comm] using sep
        exact (not_lt_of_ge large) small
    have bound : (S.card : ℝ) ≤ (⌊8*epsilon*(R : ℝ)⌋₊ : ℝ)+1 := by
      rw [card_range] at inc
      exact_mod_cast inc
    have nonneg : 0 ≤ 8*epsilon*(R : ℝ) := by positivity
    have below : (R : ℝ) ≤ B := by exact_mod_cast RB
    calc
      (S.card : ℝ) ≤ (⌊8*epsilon*(R : ℝ)⌋₊ : ℝ)+1 := bound
      _ ≤ 8*epsilon*(R : ℝ)+1 := add_le_add (Nat.floor_le nonneg) le_rfl
      _ ≤ 8*epsilon*(B : ℝ)+1 := add_le_add (mul_le_mul_of_nonneg_left below (by positivity)) le_rfl
      _ = _ := add_comm _ _
  · change (S.card : ℝ) ≤ _
    simp only [not_nonempty_iff_eq_empty.mp some,card_empty,Nat.cast_zero]
    positivity

theorem card_nearby_rational_centers_le (B : ℕ) (z epsilon : ℝ) (eps0 : 0 ≤ epsilon) :
    ((nearbyRationalCenters B z epsilon).card : ℝ) ≤ ((Nat.log 2 B : ℝ)+1)*(1+8*epsilon*(B : ℝ)) := by
  let S := nearbyRationalCenters B z epsilon
  let K := range (Nat.log 2 B+1)
  have map (c : ℕ × ℕ) (hc : c ∈ S) : Nat.log 2 c.1 ∈ K :=
    mem_range.mpr (Nat.lt_succ_of_le (Nat.log_mono_right (mem_reduced_rational_centers.mp (mem_filter.mp hc).1).2.1))
  have split : S.card = ∑ k ∈ K, (S.filter (fun c => Nat.log 2 c.1=k)).card := by
    simpa [sum_const,nsmul_eq_mul] using
      (sum_fiberwise_of_maps_to map (fun _ => (1 : ℕ))).symm
  change (S.card : ℝ) ≤ _
  rw [split,Nat.cast_sum]
  calc
    _ ≤ ∑ _ ∈ K, (1+8*epsilon*(B : ℝ)) :=
      sum_le_sum fun k _ => card_dyadic_nearby_rational_centers_le (k := k) z epsilon eps0
    _ = _ := by simp only [K,sum_const,card_range,nsmul_eq_mul,Nat.cast_add,Nat.cast_one]

end

end GoldbachTypeII13

