      _ = (2*(H : ℝ)*(g i : ℝ))/(2*(q : ℝ)*(n : ℝ)) := by ring
      _ ≤ (n : ℝ)/(2*(q : ℝ)*(n : ℝ)) := div_le_div_of_nonneg_right cap (by positivity)
