      (∑ j ∈ range e, f (t+(j : ℝ)/e)) =
        (((range e).filter (fun j : ℕ => t+(j : ℝ)/e ∈ W)).card : ℝ) * P t := by
    calc
      _ = ∑ j ∈ range e, if t+(j : ℝ)/e ∈ W then P t else 0 := by
        refine sum_congr rfl fun j _ => ?_
