    have older : (∑ j ∈ Ico (l+1) r, ‖(logWaveStep r j : ℂ)‖) =
        ∑ j ∈ Ico (l+1) r, (Real.log (j+1 : ℕ) - Real.log j) := by
      refine sum_congr rfl fun j hj => ?_
      obtain ⟨lo,up⟩ := mem_Ico.mp hj
