    (xLo : (n : ℝ)^(1/128 : ℝ) ≤ (X : ℝ)) (xHi : (X : ℝ) ≤ Real.sqrt hi)
    (mLo : (n : ℝ)^(2/5 : ℝ) ≤ (m : ℝ)) (mHi : (m : ℝ) ≤ (n : ℝ)^(3916/8192 : ℝ))
    (gCap : (m.gcd c.val : ℝ) ≤ (n : ℝ)^(1/2048 : ℝ))
