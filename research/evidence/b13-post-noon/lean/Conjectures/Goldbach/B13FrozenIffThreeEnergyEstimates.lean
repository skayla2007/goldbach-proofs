      (fun n i j h => (Nat.mul_le_mul_right _ h.2.2.1).trans (weil_near_upper_mul_le n))
  have balance (n : ℕ) : weilNearRightRampKept n = F n-E n := by
    unfold F E weilNearRightRampKept weilNearLeftCutFrom
    rw [weil_near_right_ramp_broad_eq,← sum_sub_distrib]
    refine sum_congr rfl fun i _ => ?_
    rw [← sum_sub_distrib]
    refine sum_congr rfl fun j _ => ?_
