    exact_mod_cast fact
  have first : U*B^2 ≤ B*X := by
    calc
      _ ≤ (P/((R : ℝ)+1))*B^2 := mul_le_mul_of_nonneg_right tbound (by positivity)
      _ ≤ (P/X)*B^2 :=
