    (pow_le_pow_right₀ (show 1 ≤ h from hpos) (show 1 ≤ (2 : ℕ) by decide) : h^1 ≤ h^2) :
    h ≤ h^2).trans ((Nat.le_of_dvd m0 (hdiv.trans div)).trans mn)
  exact mem_filter.mpr ⟨mem_Icc.mpr ⟨m0,mn⟩,h,mem_Ioc.mpr ⟨high,upper⟩,hdiv.trans div⟩

theorem proper_prime_power_mem_square_support {n m b : ℕ} (m0 : 0 < m) (mn : m ≤ n)
    (bu : cutoffU n < b) (bp : ¬ b.Prime) (power : IsPrimePow b) (div : b ∣ m) :
    m ∈ squareMultipleSupport n (properPowerSquareCut n) := by
  have bound : (properPowerSquareCut n)^3 ≤ cutoffU n := by
    apply Nat.le_floor
    rw [Nat.cast_pow]
    refine (pow_le_pow_left₀ (by positivity) (Nat.floor_le (by positivity)) 3).trans_eq ?_
    rw [← Real.rpow_mul_natCast (by positivity)]
    norm_num
  exact large_prime_power_mem_square_support m0 mn (bound.trans_lt bu) bp power div


end

theorem sum_inverse_squares_tail_le {A N : ℕ} (A0 : 0 < A) (AN : A ≤ N) :
    (∑ h ∈ Ioc A N, 1/(h : ℝ)^2) ≤ 1/(A : ℝ) :=
  (sum_inverse_squares_le A N A0 AN).trans (sub_le_self _ (by positivity))


