  let φ := ZMod.castHom (Nat.gcd_dvd_left m c.val) (ZMod d)
  have h : φ c=0 := by
    rw [← ZMod.natCast_zmod_val c,map_natCast]
    exact (ZMod.natCast_eq_zero_iff _ _).mpr (Nat.gcd_dvd_right _ _)
  have hn : d ∣ n := by
    unfold c at h
    rw [map_natCast] at h
