    frozenGoal ↔ saving (fun n => farInnerAfterTrimming n + outsideExpandedAfterProperPower n) := by
  rw [frozen_iff_after_far_inner_trimming]
  have eq (n : ℕ) : farInnerAfterTrimming n + arithmeticOutsideExpanded n =
