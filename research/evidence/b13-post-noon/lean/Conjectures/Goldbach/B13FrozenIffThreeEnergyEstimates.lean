    (show (u : ℝ) ≤ (⌊(n : ℝ)^(27/64 : ℝ)⌋₊ : ℕ) by exact_mod_cast hu).trans (Nat.floor_le (by positivity))
  have nR : (0 : ℝ) < n := by exact_mod_cast hn
  have small : (u : ℝ)*(rightLowWaveStep j : ℝ) ≤ n := by
    calc
