    (Real.one_le_rpow (by exact_mod_cast hn) (by norm_num))
  have gt : 1 < d := cut.trans_lt (mem_Ioc.mp hd).1
  have unit := long_right_low_squarefree_of_ne_zero hj weight d (by simpa only [pow_two] using sq)
  exact gt.ne' (Nat.isUnit_iff.mp unit)

end

