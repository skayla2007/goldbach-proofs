    refine sum_subset (filter_subset _ _) fun e he outside => ?_
    have small : e ≤ D := le_of_not_gt fun big => outside (mem_filter.mpr ⟨he,big⟩)
    rw [large_gcd_divisor_weight_zero small, Complex.ofReal_zero]
  rw [full, scalar]
  split_ifs <;> simp

end

end GoldbachTypeII13

