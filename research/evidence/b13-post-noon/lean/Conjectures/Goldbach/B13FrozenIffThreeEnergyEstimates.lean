  apply norm_bilateral_right_high_step_mass_from_pointwise T0 divisors (rightRestrictedHighWeight n keep) _ u hu
  intro j hj
  have hb := (mem_Icc.mp (mem_product.mp (mem_sigma.mp (mem_filter.mp hj).1).2).2).2
  rw [rightRestrictedHighWeight,norm_mul,norm_neg]
