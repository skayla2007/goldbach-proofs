      calc
        _ = (n : ℝ)^(255/128 : ℝ) := by rw [← Real.rpow_natCast, ← Real.rpow_mul nr.le]; norm_num
        _ = (n : ℝ)^(127/128 : ℝ)*(n : ℝ)^(1 : ℝ) := by rw [← Real.rpow_add nr]; norm_num
