def squareMultipleSupport (n A : ℕ) : Finset ℕ :=
  (Icc 1 n).filter (fun m => ∃ h ∈ Ioc A n, h^2 ∣ m)

private theorem sum_inverse_squares_le (A N : ℕ) (A0 : 0 < A) (AN : A ≤ N) :
    (∑ h ∈ Ioc A N, 1/(h : ℝ)^2) ≤ 1/(A : ℝ) - 1/(N : ℝ) := by
  induction N,AN using Nat.le_induction with
  | base => simp
  | succ k hk ih =>
    have eq : Ioc A (k+1) = insert (k+1) (Ioc A k) := by
      ext x
      simp only [mem_Ioc,mem_insert]
      omega
    have outside : k+1 ∉ Ioc A k := by simp
    have kp : (0 : ℝ) < k := by exact_mod_cast (A0.trans_le hk)
    have kt : 1/((k+1 : ℕ) : ℝ)^2 ≤ 1/(k : ℝ) - 1/((k+1 : ℕ) : ℝ) := by
      push_cast
      field_simp
      nlinarith
    rw [eq,sum_insert outside]
    linarith only [ih,kt]

theorem card_square_multiple_support_le {n A : ℕ} (A0 : 0 < A) (AN : A ≤ n) :
    ((squareMultipleSupport n A).card : ℝ) ≤ (n : ℝ)/A := by
  let S (h : ℕ) := (Icc 1 n).filter (fun m => h^2 ∣ m)
  have cover : squareMultipleSupport n A = (Ioc A n).biUnion S := by
    ext m
    simp only [squareMultipleSupport,S,mem_biUnion,mem_filter]
    constructor
    · rintro ⟨mpos,h,hr,d⟩
      exact ⟨h,hr,mpos,d⟩
    · rintro ⟨h,hr,mpos,d⟩
      exact ⟨mpos,h,hr,d⟩
  have count (h : ℕ) : (S h).card = n/h^2 := by
    have same : S h = (range (n+1)).filter (fun m => m ≠ 0 ∧ h^2 ∣ m) := by
      ext m
      simp only [S,mem_filter,mem_Icc,mem_range]
      omega
    rw [same]
    exact Nat.card_multiples' n (h^2)
  calc
    _ ≤ ∑ h ∈ Ioc A n, ((S h).card : ℝ) := by
      rw [cover,← Nat.cast_sum]
      exact_mod_cast card_biUnion_le
    _ ≤ ∑ h ∈ Ioc A n, (n : ℝ)/(h : ℝ)^2 := by
      refine sum_le_sum fun h _ => ?_
      rw [count,← Nat.cast_pow]
      exact Nat.cast_div_le
    _ = (n : ℝ)*(∑ h ∈ Ioc A n, 1/(h : ℝ)^2) := by simp_rw [mul_sum,mul_one_div]
    _ ≤ (n : ℝ)/A := by
      rw [← mul_one_div]
      exact mul_le_mul_of_nonneg_left ((sum_inverse_squares_le A n A0 AN).trans
        (sub_le_self _ (by positivity))) (by positivity)

