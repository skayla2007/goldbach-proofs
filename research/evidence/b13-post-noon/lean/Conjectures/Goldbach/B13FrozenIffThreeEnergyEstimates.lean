    · by_cases region : cut u m <;> simp [u,m,h,kept,region]
    · simp [u,m,h,kept]
  · simp [u,m,h]

theorem far_inner_prime_eq_wider_add_band (n : ℕ) {κ : Type} (J : Finset κ) (v p s : κ → ℕ) (w : κ → ℂ) :
