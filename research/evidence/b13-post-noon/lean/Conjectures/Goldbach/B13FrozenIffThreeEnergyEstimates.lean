      unfold X
      rw [← Real.rpow_mul_natCast nr.le,← Real.rpow_add nr,← Real.rpow_add_one nr.ne']
      congr 1
      norm_num
    calc
      _ ≤ (15/2)*(n : ℝ)^(95/96 : ℝ)*T^10*logBudget n^3 :=
        norm_outside_proper_power_contribution_le hn T1 (dBound n)
      _ ≤ (15/2)*(n : ℝ)^(95/96 : ℝ)*T^10*X^3 := by gcongr
      _ = C*((n : ℝ)^(95/96 : ℝ)*X^13) := by unfold C T; ring
      _ = (C*(n : ℝ)^(-(1/192) : ℝ))*(n : ℝ) := by rw [ex]; ring
      _ ≤ _ := mul_le_mul_of_nonneg_right small.le nr.le
  obtain ⟨N,h⟩ := eventually_atTop.mp estimate
  exact ⟨N,fun n hn _ => h n hn⟩

