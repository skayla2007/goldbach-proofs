  have Ediv : N/((E : ℝ)+1) ≤ N^(2047/2048 : ℝ) := by
    calc
      _ ≤ N/N^(1/2048 : ℝ) := div_le_div_of_nonneg_left np.le (by positivity) (Nat.lt_floor_add_one _).le
