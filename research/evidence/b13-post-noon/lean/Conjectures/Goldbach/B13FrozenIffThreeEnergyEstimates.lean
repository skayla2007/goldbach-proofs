    _ ≤ ∑ j ∈ J, ‖rightLowWaveWeight j*weilNearRightRampRow n (rightLowWaveStep j) (lower n j) (upper n j)‖ := norm_sum_le _ _
    _ ≤ ∑ j ∈ J, ‖rightLowWaveWeight j‖*(B*(1/(rightLowWaveStep j : ℝ))) := by
      refine sum_le_sum fun j hj => ?_
