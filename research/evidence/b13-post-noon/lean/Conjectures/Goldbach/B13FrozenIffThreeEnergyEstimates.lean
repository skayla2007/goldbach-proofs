    (m0 : 0 < m) (mn : m ≤ n) (h : highHasLargeProperFactor n j) (d : rightHighWaveStep j ∣ m) :
    m ∈ highProperFrequencySupport n := by
  obtain ⟨b,bdiv,big,nonprime,power⟩ := h
  exact large_proper_factor_frequency_mem_support m0 mn big nonprime power
    ((bdiv.trans (dvd_mul_left j.2.2 (j.1*j.2.1))).trans d)

