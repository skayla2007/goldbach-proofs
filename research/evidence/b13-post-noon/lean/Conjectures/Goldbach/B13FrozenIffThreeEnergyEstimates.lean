  refine sum_congr rfl fun i _ => ?_
  rw [← sum_add_distrib]
  refine sum_congr rfl fun j _ => ?_
  by_cases h : u i*v j ≤ maximumStep n^2
  · simp [h,not_lt_of_ge h]
  · simp [h,lt_of_not_ge h]

