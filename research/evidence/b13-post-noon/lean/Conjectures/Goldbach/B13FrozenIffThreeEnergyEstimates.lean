      ((dvd_mul_left j.1 j.2).trans d)
  have steps := norm_gated_wave_family_le
    (H := maximumStep n^2) (M := maximumStep n)
    (outsideLeftItems n) (outsideProperPowerItems n) SL SR
    leftBilinearStep (fun _ => 0) (fun i => n/leftBilinearStep i)
    rightLowWaveStep (fun _ => 0) (rightLowWaveUpper n) (leftBilinearWeight n) rightLowWaveWeight
    W0 W0 T0 c0 Istep Jstep (fun _ _ => le_rfl) (fun _ _ => min_le_right _ _)
    Imass Jmass divisors leftSupp rightSupp
  have cardL : (SL.card : ℝ) = N := by simp [SL,N,Nat.card_Icc]
  have cardR : (SR.card : ℝ) ≤ 2*N^(47/48 : ℝ) :=
    card_proper_power_square_support_le (by omega)
  have outer : ((n.log2+1 : ℕ) : ℝ) ≤ 5*L := by
    rw [Nat.log2_eq_log_two,Nat.cast_add,Nat.cast_one]
    exact natLog_succ_le n2 le_rfl
