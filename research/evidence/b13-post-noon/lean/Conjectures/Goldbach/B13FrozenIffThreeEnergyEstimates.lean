  have bound := floor_half_le p1
  have grow : (n : ℝ) ≤ (n : ℝ)^(4097/4096 : ℝ) := by
    calc
      _ = (n : ℝ)^(1 : ℝ) := (Real.rpow_one _).symm
      _ ≤ _ := Real.rpow_le_rpow_of_exponent_le n1 (by norm_num)
  have cap : (n : ℝ) ≤ 2*(⌊(n : ℝ)^(4097/4096 : ℝ)⌋₊ : ℝ) := by linarith only [bound,grow]
