def restrictedMangoldtAfter (P : ℕ) (keep : ℕ → Prop) : ArithmeticFunction ℝ :=
  ⟨fun b => if P<b ∧ keep b then vonMangoldt b else 0, by simp⟩

def restrictedVaughanFactor (P : ℕ) (keep : ℕ → Prop) : ArithmeticFunction ℝ :=
