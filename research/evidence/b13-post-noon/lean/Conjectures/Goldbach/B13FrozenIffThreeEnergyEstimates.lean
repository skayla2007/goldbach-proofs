theorem energy_mangoldt_le (U Y : ℕ) :
    (∑ b ∈ Ioc (0 : ℤ) (Y : ℤ), ‖mangoldtExtension U b‖ ^ 2) ≤
      (Y : ℝ) * Real.log ((Y : ℝ) + 2) ^ 2 := by
  have atOne (j : ℕ) (membership : j ∈ range Y) : ‖mangoldtAbove U j‖ ≤ Real.log ((Y : ℝ) + 2) := by
    unfold mangoldtAbove
