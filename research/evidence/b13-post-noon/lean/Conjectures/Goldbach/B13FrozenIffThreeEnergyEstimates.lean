      ring

theorem int_cast_injOn_Ioc_zero {p : ℕ} [NeZero p] :
    Set.InjOn (fun j : ℤ => (j : ZMod p)) ((Ioc (0 : ℤ) (p : ℤ) : Finset ℤ) : Set ℤ) := by
