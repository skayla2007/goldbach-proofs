theorem inner_prime_mask_saving_of_original {κ : Type} (J : ℕ → Finset κ)
    (v : κ → ℕ) (p s : ℕ → κ → ℕ) (w : ℕ → κ → ℂ)
    (keep : ℕ → ℕ → ℕ → Prop)
