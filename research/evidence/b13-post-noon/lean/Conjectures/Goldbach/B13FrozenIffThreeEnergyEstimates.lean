      outsideTargetKeptFrom n (J.filter (fun j => ¬keep j)) v p s w := by
  have pos : (J.filter keep).filter (fun j => targetDivisorKept n (v j)) =
      (J.filter (fun j => targetDivisorKept n (v j))).filter keep := by
    ext j
    simp only [mem_filter]
    tauto
  have neg : (J.filter (fun j => ¬keep j)).filter (fun j => targetDivisorKept n (v j)) =
      (J.filter (fun j => targetDivisorKept n (v j))).filter (fun j => ¬keep j) := by
    ext j
    simp only [mem_filter]
    tauto
  unfold outsideTargetKeptFrom
  rw [pos,neg]
  exact outside_expanded_against_right_split n _ _ _ _ _ _ keep

theorem trimmed_right_window_split_right (n : ℕ) {κ : Type} (J : Finset κ)
    (v p s : κ → ℕ) (w : κ → ℂ) (keep : κ → Prop) :
    trimmedRightWindowContribution n J v p s w =
      trimmedRightWindowContribution n (J.filter keep) v p s w +
      trimmedRightWindowContribution n (J.filter (fun j => ¬keep j)) v p s w := by
  unfold trimmedRightWindowContribution
  rw [far_inner_thin_split_right n J v p s w keep,outside_target_kept_split_right n J v p s w keep]
