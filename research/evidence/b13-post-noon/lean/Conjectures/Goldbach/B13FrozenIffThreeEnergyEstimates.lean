private theorem short_right_saving_add {f g : ℕ → ℂ} (hf : saving f) (hg : saving g) :
    saving (fun n => f n+g n) := by
  intro e he
  obtain ⟨N,hN⟩ := hf (e/2) (by positivity)
  obtain ⟨M,hM⟩ := hg (e/2) (by positivity)
  refine ⟨max N M,fun n hn even => ?_⟩
  exact (norm_add_le _ _).trans (by linarith only [hN n (by omega) even,hM n (by omega) even])

theorem trimmed_short_window_saving {κ : Type} (J : ℕ → Finset κ)
    (v : κ → ℕ) (p s : ℕ → κ → ℕ) (w : ℕ → κ → ℂ)
    (steps : ∀ n j, j ∈ J n → v j ∈ Icc 1 n)
    (short : ∀ n j, j ∈ J n → v j ≤ maximumStep n)
    (ends : ∀ n j, j ∈ J n → s n j ≤ n/v j)
    (mass : ∀ (n : ℕ) (T : ℝ), 1 ≤ T → (∀ m ≤ n, (m.divisors.card : ℝ) ≤ T) →
      ∀ q ∈ Icc 1 n, (∑ j ∈ (J n).filter (fun j => v j=q), ‖w n j‖) ≤ T^3*logBudget n)
