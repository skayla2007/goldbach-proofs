    (bilateralLeftWaveItems n) J leftBilinearStep (fun _ => 0) (fun i => n/leftBilinearStep i)
    rightLowWaveStep (fun _ => 0) (rightLowWaveUpper n) (leftBilinearWeight n) rightLowWaveWeight
    (fun _ h => (mem_Icc.mp (bilateral_left_step_range h)).1)
    (fun _ h => (mem_Icc.mp (bilateral_right_low_step_range (base h))).1)

