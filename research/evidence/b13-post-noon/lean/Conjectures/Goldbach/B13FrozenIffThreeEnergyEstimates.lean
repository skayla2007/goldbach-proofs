    (fun n _ _ hT _ => card_ordinary_frequency_range_le n hT)
  have rightSave := outside_weighted_at_gcd_sparse_frequency_saving M B C (fun n => Icc 1 n)
    highProperFrequencySupport (fun _ => v) p s a w (αL := 0) (αR := 1/2048) (by norm_num)
