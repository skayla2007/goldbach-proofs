    leftBilinearStep (fun _ => 0) (fun i => n/leftBilinearStep i) rightHighWaveStep (rightHighWaveLower n)
    (fun j => n/rightHighWaveStep j) (leftBilinearWeight n) (rightHighWaveWeight n)
