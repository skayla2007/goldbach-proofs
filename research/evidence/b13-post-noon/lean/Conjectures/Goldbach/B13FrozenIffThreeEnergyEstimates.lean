    _ = _ := by
      rw [show c*(N*T*(W*T)^2) = (c*N)*(T*(W*T)^2) by ring,
        show c⁻¹*(2*N^(47/48 : ℝ)*T*(W*T)^2) = 2*(c⁻¹*N^(47/48 : ℝ))*(T*(W*T)^2) by ring,
