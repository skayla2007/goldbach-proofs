    omega
  have GR (k : ℕ) : (∑ d ∈ D, ∑ h ∈ A, ∫ t in (0 : ℝ)..1, ‖g k d h t‖^2) ≤ R := by
    dsimp only [g,R,D]
    simp_rw [right_row_filter]
    apply divisible_step_grouped_energy_le (n := n) (W := W₂) (T := T) J A SR
      (fun j h => binaryRight k h (min n (H/v j))) v p s b W₂0 T0 right leR massR divisors _ suppR
