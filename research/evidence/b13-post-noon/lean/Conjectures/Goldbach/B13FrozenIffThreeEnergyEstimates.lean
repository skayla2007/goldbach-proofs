    _ = 2*(n : ℝ)^(47/48 : ℝ) := by
      congr 1
      calc
        _ = (n : ℝ)^(1 : ℝ) / (n : ℝ)^(1/48 : ℝ) := by rw [Real.rpow_one]
        _ = _ := by
          rw [← Real.rpow_sub (show (0 : ℝ)<n by positivity)]
