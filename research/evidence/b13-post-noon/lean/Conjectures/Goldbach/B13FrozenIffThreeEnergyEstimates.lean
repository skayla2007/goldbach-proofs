noncomputable section

def weilNearRightRows (n : ℕ) : Finset RightLowWaveIndex :=
  (longRightLowItems n).filter fun j =>
    let v := rightLowWaveStep j
    widerLowFarModulusCap n < v ∧ v.gcd n ≤ sparseTargetDivisorCap n ∧ v.gcd n ≤ targetDivisorCap n

def weilNearProductLower (n : ℕ) (j : RightLowWaveIndex) (_ : ℕ) : ℕ :=
  let v := rightLowWaveStep j
  max ⌊(n : ℝ)^(27/64 : ℝ)⌋₊
    (max (maximumStep n^2/v) (max (thinHighProductCap n/v) (highFarStripProductCap n/v)))

def weilNearProductUpper (n : ℕ) (j : RightLowWaveIndex) (_ : ℕ) : ℕ :=
  let v := rightLowWaveStep j
  min (extendedWideStepCap n) (min (expandedWideStepCap n) (min v (weilNearProductCap n/v)))

def weilNearGroupGate (n : ℕ) (i : ℕ × ℕ) (j : RightLowWaveIndex) : Prop :=
  let u := leftBilinearStep i
  let v := rightLowWaveStep j
  let g := u.gcd v
  g ∈ weilNearRowDivisors n v ∧ weilNearProductLower n j g < u ∧ u ≤ weilNearProductUpper n j g ∧
    i.1 ≤ primeHyperbolaFactorFloor n 32

def weilNearRightRampKept (n : ℕ) : ℂ :=
  ∑ i ∈ bilateralLeftWaveItems n, ∑ j ∈ weilNearRightRows n,
    leftPrimeWeight n i*rightLowWaveWeight j*
      (if weilNearGroupGate n i j ∧ weilNearLeftKept n (leftBilinearStep i) then
        (rightInverseRamp n (leftBilinearStep i) (rightLowWaveStep j) : ℂ) else 0)

private theorem weil_near_right_rows_sub (n : ℕ) : weilNearRightRows n ⊆ rightLowWaveItems n :=
  fun _ hj => long_right_low_subset n (mem_filter.mp hj).1

private theorem weil_near_upper_mul_le (n : ℕ) {j : RightLowWaveIndex} {g : ℕ} :
    weilNearProductUpper n j g*rightLowWaveStep j ≤ weilNearProductCap n := by
  calc
    _ ≤ (weilNearProductCap n/rightLowWaveStep j)*rightLowWaveStep j :=
      Nat.mul_le_mul_right _ (le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_right _ _)))
    _ ≤ _ := Nat.div_mul_le_self _ _

private theorem weil_near_right_ramp_broad_saving :
    saving (weilNearRightRampSlice weilNearRightRows weilNearProductLower weilNearProductUpper) := by
  apply weil_near_right_ramp_saving
  · intro n j hj
    exact ⟨weil_near_right_rows_sub n hj,long_right_low_step_le_power (mem_filter.mp hj).1,
      (mem_filter.mp hj).2.2.1⟩
  · intro n j hj g
    exact (min_le_right _ _).trans ((min_le_right _ _).trans (min_le_left _ _))
  · intro n j hj g
    exact weil_near_upper_mul_le n

set_option maxHeartbeats 1200000 in
private theorem weil_near_right_ramp_broad_eq {n : ℕ} :
    weilNearRightRampSlice weilNearRightRows weilNearProductLower weilNearProductUpper n =
      ∑ i ∈ bilateralLeftWaveItems n, ∑ j ∈ weilNearRightRows n,
        leftPrimeWeight n i*rightLowWaveWeight j*
        (if weilNearGroupGate n i j then (rightInverseRamp n (leftBilinearStep i) (rightLowWaveStep j) : ℂ)
          else 0) := by
  unfold weilNearRightRampSlice
  rw [sum_comm]
  refine sum_congr rfl fun j hj => ?_
  have ranges := mem_Icc.mp (bilateral_right_low_step_range (weil_near_right_rows_sub n hj))
  have n1 : 1 ≤ n := ranges.1.trans ranges.2
  have lower (g : ℕ) : leftMediumCap n ≤ weilNearProductLower n j g :=
    (Nat.floor_mono (Real.rpow_le_rpow_of_exponent_le (by exact_mod_cast n1) (by norm_num))).trans
      (le_max_left _ _)
  rw [weil_near_right_ramp_row_eq_selected (upper := weilNearProductUpper n j) ranges.1 ranges.2 lower (fun _ => min_le_left _ _)]
  have items : weilNearRightRampRowItems n (rightLowWaveStep j) (weilNearProductLower n j) (weilNearProductUpper n j) =
      (bilateralLeftWaveItems n).filter (fun i => weilNearGroupGate n i j) := by
    ext i
    simp only [weilNearRightRampRowItems,mem_filter]
    rfl
  rw [items,sum_filter,mul_sum]
