  change (∑ m ∈ range (n + 1), (bandCoefficient n L V weight m : ℂ) * f m) = _
  simp only [band_as_progression_tails n L V _ weight ordered, Complex.ofReal_sub,
    cast, sub_mul, sum_sub_distrib]
