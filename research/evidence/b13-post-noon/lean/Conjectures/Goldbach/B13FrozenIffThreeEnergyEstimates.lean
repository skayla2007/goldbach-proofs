    have eq : β+(a : ℝ)/q=t := by unfold β; ring
    rw [← eq, wave_at_cell_center hq threadU]
  have vs : wave v p s t = wave v p s β := by
    have eq : β+(a : ℝ)/q=t := by unfold β; ring
    rw [← eq, wave_at_cell_center hq threadV]
