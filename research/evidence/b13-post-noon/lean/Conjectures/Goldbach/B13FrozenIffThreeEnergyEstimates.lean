      injection first with dSame sSame
      subst e
      subst r
      change d*k*s = d*p*s at eq
      have kSame := Nat.eq_of_mul_eq_mul_left (mem_Icc.mp hd).1
        (Nat.eq_of_mul_eq_mul_right (mem_Icc.mp hs).1 eq)
