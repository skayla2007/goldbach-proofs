private theorem short_step_le_small_modulus {n : ℕ} (hn : 0 < n) :
    maximumStep n ≤ expandedHighModulusCap n := by
  have n1 : (1 : ℝ) ≤ n := by exact_mod_cast hn
  apply Nat.le_floor
  exact (maximumStep_le_power n hn).trans (Real.rpow_le_rpow_of_exponent_le n1 (by norm_num))

private theorem gated_window_sum_eq_residue (n : ℕ) {κ : Type} (J : Finset κ)
    (v p s : κ → ℕ) (w : κ → ℂ)
    (steps : ∀ j ∈ J, v j ∈ Icc 1 n) :
    leftAgainstWaveFamily n (bilateralLeftWaveItems n) J v p s w =
    rawWavePairSum n (bilateralLeftWaveItems n) J v p s w (prefixStepGate n) (residueWindowPair n) := by
  unfold leftAgainstWaveFamily leftAgainstWaveFamilyAtGcd gatedWaveFamily rawWavePairSum
  refine sum_congr rfl fun i hi => sum_congr rfl fun j hj => ?_
  have u0 := (mem_Icc.mp (bilateral_left_step_range hi)).1
  have v0 := (mem_Icc.mp (steps j hj)).1
  dsimp only
  rw [deep_wave_pair_eq_residue_window (n := n) u0 v0]
  by_cases h : prefixStepGate n (leftBilinearStep i) (v j)
  · have g : maximumStep n^2 < leftBilinearStep i*v j ∧
        (leftBilinearStep i).gcd (v j) ≤ maximumStep n := h
    rw [if_pos h,if_pos g]
  · have g : ¬(maximumStep n^2 < leftBilinearStep i*v j ∧
        (leftBilinearStep i).gcd (v j) ≤ maximumStep n) := h
    rw [if_neg h,if_neg g]

private theorem short_window_raw_inside_eq (n : ℕ) {κ : Type} (J : Finset κ)
    (v p s : κ → ℕ) (w : κ → ℂ)
    (short : ∀ j ∈ J, v j ≤ maximumStep n) :
    rawExpandedWavePairSum n J v p s w
      (fun u v l r a b => (pairResidueError n u v l r a b : ℂ)) =
    boundedOuterLeftBaseFrom farInnerGate n J v p s w +
    boundedOuterLeftBaseFrom smallModulusProductGate n J v p s w := by
  unfold rawExpandedWavePairSum rawWavePairSum boundedOuterLeftBaseFrom
  simp only [← sum_add_distrib]
  refine sum_congr rfl fun i hi => sum_congr rfl fun j hj => ?_
  have range := mem_Icc.mp (bilateral_left_step_range (mem_filter.mp hi).1)
  have n0 : 0 < n := (Nat.zero_lt_one.trans_le range.1).trans_le range.2
  have small := (short j (mem_filter.mp hj).1).trans (short_step_le_small_modulus n0)
  by_cases pref : prefixStepGate n (leftBilinearStep i) (v j)
  · by_cases cap : leftBilinearStep i*v j ≤ highFarStripProductCap n
    · have notFar : ¬farInnerGate n (leftBilinearStep i) (v j) :=
        fun h => (not_lt_of_ge cap) h.2
      have near : smallModulusProductGate n (leftBilinearStep i) (v j) := ⟨small,pref,cap⟩
      simp only [if_pos pref,if_neg notFar,if_pos near,zero_add]
    · have far : farInnerGate n (leftBilinearStep i) (v j) := ⟨pref,lt_of_not_ge cap⟩
      have notNear : ¬smallModulusProductGate n (leftBilinearStep i) (v j) :=
        fun h => cap h.2.2
      simp only [if_pos pref,if_pos far,if_neg notNear,add_zero]
  · have notFar : ¬farInnerGate n (leftBilinearStep i) (v j) := fun h => pref h.1
    have notNear : ¬smallModulusProductGate n (leftBilinearStep i) (v j) := fun h => pref h.2.1
    simp only [if_neg pref,if_neg notFar,if_neg notNear,zero_add]

