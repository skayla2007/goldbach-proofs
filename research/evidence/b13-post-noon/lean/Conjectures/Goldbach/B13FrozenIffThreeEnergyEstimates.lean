      leftBilinearStep (fun _ => 0) (fun i => n/leftBilinearStep i) (v n) (p n) (s n) (leftBilinearWeight n) (w n) T1
      (fun _ h => bilateral_left_step_range h) (steps n)
      (fun _ _ => le_rfl) (ends n)
