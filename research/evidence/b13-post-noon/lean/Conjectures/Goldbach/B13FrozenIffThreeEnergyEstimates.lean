    retainedExpandedHigh n (squareFreeInnerMask n (retainedAfterHighMedium n))) +
  (outsideSquareKept n (longRightLowItems n) rightLowWaveStep (fun _ => 0)
      (rightLowWaveUpper n) rightLowWaveWeight +
    outsideSquareKept n (longRightHighItems n) rightHighWaveStep (rightHighWaveLower n)
      (fun j => n/rightHighWaveStep j) (rightHighPrimeWeight n))

def squareStepCorrection (n : ℕ) : ℂ :=
  (innerSquareCorrection n (longRightLowItems n) rightLowWaveStep (fun _ => 0) (rightLowWaveUpper n)
      rightLowWaveWeight (retainedLowTargetMask n) +
    innerSquareCorrection n (longRightHighItems n) rightHighWaveStep (rightHighWaveLower n)
      (fun j => n/rightHighWaveStep j) (rightHighPrimeWeight n) (retainedAfterHighMedium n)) +
  (outsideSquareCorrection n (longRightLowItems n) rightLowWaveStep (fun _ => 0)
      (rightLowWaveUpper n) rightLowWaveWeight +
    outsideSquareCorrection n (longRightHighItems n) rightHighWaveStep (rightHighWaveLower n)
      (fun j => n/rightHighWaveStep j) (rightHighPrimeWeight n))

