/- Source PEqualNP.Outside.L_b13_binary_comparison -/
section

namespace GoldbachTypeII13

open Finset
open scoped Classical

abbrev binaryLeft (k a u : ℕ) : Prop := u / 2^k = 2*a+1
abbrev binaryRight (k a v : ℕ) : Prop := v / 2^k = 2*a

theorem binary_comparator_sum {R : Type*} [AddCommMonoidWithOne R]
    (k n u v : ℕ) (hn : u ≤ n) :
    (∑ j ∈ range k, ∑ a ∈ range (n+1),
      if binaryLeft j a u ∧ binaryRight j a v then (1 : R) else 0) +
      (if v/2^k < u/2^k then 1 else 0) = if v<u then 1 else 0 := by
  classical
  induction k with
  | zero => simp
  | succ k ih =>
    rw [sum_range_succ, add_assoc, ← ih]
    refine congrArg (fun z : R => (∑ j ∈ range k, ∑ a ∈ range (n+1),
      if binaryLeft j a u ∧ binaryRight j a v then (1 : R) else 0)+z) ?_
    set A := u/2^k
    set B := v/2^k
    have HA : A ≤ n := (Nat.div_le_self _ _).trans hn
    have div_u : u/2^(k+1) = A/2 := by rw [pow_succ,← Nat.div_div_eq_div_mul]
    have div_v : v/2^(k+1) = B/2 := by rw [pow_succ,← Nat.div_div_eq_div_mul]
    rw [div_u,div_v]
    have last : (∑ a ∈ range (n+1), if A=2*a+1 ∧ B=2*a then (1:R) else 0) =
        if A=2*(A/2)+1 ∧ B=2*(A/2) then 1 else 0 := by
      apply sum_eq_single_of_mem (A/2) (mem_range.mpr (Nat.lt_succ_of_le ((Nat.div_le_self _ _).trans HA)))
      intro a _ neu
      apply if_neg
      omega
    unfold binaryLeft binaryRight
    change (∑ a ∈ range (n+1), if A=2*a+1 ∧ B=2*a then (1:R) else 0) +
      (if B/2<A/2 then 1 else 0) = (if B<A then 1 else 0)
    rw [last]
    by_cases same : A=2*(A/2)+1 ∧ B=2*(A/2)
    · have h₁ : B/2 = A/2 := by omega
      have h₂ : B<A := by omega
      have h₃ : ¬ B/2 < A/2 := by omega
      rw [if_pos same, if_neg h₃, if_pos h₂, add_zero]
    · have eq : (B/2<A/2) ↔ (B<A) := by omega
      rw [if_neg same, zero_add]
      by_cases h : B<A
      · rw [if_pos (eq.mpr h),if_pos h]
      · rw [if_neg (fun t => h (eq.mp t)),if_neg h]

theorem binary_comparator_indicator {R : Type*} [AddCommMonoidWithOne R]
    {n u v : ℕ} (hu : u ≤ n) (hv : v ≤ n) :
    (∑ j ∈ range (n.log2+1), ∑ a ∈ range (n+1),
      if binaryLeft j a u ∧ binaryRight j a v then (1 : R) else 0) =
      if v<u then 1 else 0 := by
  classical
  have eq := binary_comparator_sum (R := R) (n.log2+1) n u v hu
  rw [Nat.div_eq_of_lt (hv.trans_lt Nat.lt_log2_self),
    Nat.div_eq_of_lt (hu.trans_lt Nat.lt_log2_self), if_neg (Nat.lt_irrefl _), add_zero] at eq
  exact eq

end GoldbachTypeII13

