    rw [← ZMod.natCast_zmod_val z,map_natCast]
    exact (ZMod.natCast_eq_zero_iff _ _).mpr (Nat.gcd_dvd_right _ _)
  have val (x : ZMod m) : φ x = (x.val : ZMod d) := by
    have t := congrArg φ (ZMod.natCast_zmod_val x)
    rw [map_natCast] at t
    exact t.symm
