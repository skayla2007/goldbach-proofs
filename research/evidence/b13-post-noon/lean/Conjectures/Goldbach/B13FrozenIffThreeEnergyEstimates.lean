  congr 1
  ext d
  simp only [mem_filter,mem_Icc,Nat.mem_divisors,ne_eq]
  constructor
  · rintro ⟨_,du,dv⟩
    exact ⟨Nat.dvd_gcd du dv,pos.ne'⟩
  · rintro ⟨dg,_⟩
    have d0 := Nat.pos_of_dvd_of_pos dg pos
    exact ⟨⟨d0,(Nat.le_of_dvd pos dg).trans gbound⟩,dg.trans (Nat.gcd_dvd_left _ _),
      dg.trans (Nat.gcd_dvd_right _ _)⟩

