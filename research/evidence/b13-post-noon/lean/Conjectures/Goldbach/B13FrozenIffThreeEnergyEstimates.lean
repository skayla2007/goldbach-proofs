    maskedWaveProduct n (bilateralLeftOpenWave n) (lowPrefixRightWave n J) =
      maskedWaveProduct n (originalLeftWave n) (lowPrefixRightWave n J) +
        ((leftTypeOnePairAgainst n (vaughanZetaWeight n) (lowPrefixRightCoefficient n J) -
          leftTypeOnePairAgainst n (vaughanLogWeight n) (lowPrefixRightCoefficient n J)) -
          leftSmallPairAgainst n (lowPrefixRightCoefficient n J)) +
        maskedWaveProduct n (lowPrefixRightWave n J) (bilateralLeftEndpointWave n) := by
  rw [low_prefix_right_eq_plain base]
  exact original_to_open_left_with_plain hn (lowPrefixRightCoefficient n J)

theorem open_left_short_right_prefix_saving (J : ℕ → Finset RightLowWaveIndex)
    (base : ∀ n j, j ∈ J n → j ∈ rightLowWaveItems n ∧ rightLowWaveStep j ≤ maximumStep n) :
    saving (fun n => maskedWaveProduct n (bilateralLeftOpenWave n) (lowPrefixRightWave n (J n))) := by
  intro e he
  obtain ⟨N,hN⟩ := original_left_short_right_prefix_saving J base (e/2) (by positivity)
  obtain ⟨M,hM⟩ := eventually_atTop.mp
    (eventual_left_corrections_against J (fun n j hj => (base n j hj).1) (e/2) (by positivity))
  refine ⟨max 1 (max N M),fun n hn even => ?_⟩
  change ‖maskedWaveProduct n (bilateralLeftOpenWave n) (lowPrefixRightWave n (J n))‖ ≤ _
  rw [original_to_open_left_against (by omega) (fun j hj => (base n j hj).1)]
  let P := maskedWaveProduct n (originalLeftWave n) (lowPrefixRightWave n (J n))
  let L := leftTypeOnePairAgainst n (vaughanLogWeight n) (lowPrefixRightCoefficient n (J n))
  let Z := leftTypeOnePairAgainst n (vaughanZetaWeight n) (lowPrefixRightCoefficient n (J n))
  let S := leftSmallPairAgainst n (lowPrefixRightCoefficient n (J n))
  let E := maskedWaveProduct n (lowPrefixRightWave n (J n)) (bilateralLeftEndpointWave n)
  change ‖P+(Z-L-S)+E‖ ≤ _
  have hp : ‖P‖ ≤ (e/2)*(n : ℝ) := hN n (by omega) even
  have hm : ‖L‖+‖Z‖+‖S‖+‖E‖ ≤ (e/2)*(n : ℝ) := hM n (by omega)
  have hs : ‖Z-L-S‖ ≤ ‖Z‖+‖L‖+‖S‖ :=
    (norm_sub_le (Z-L) S).trans (add_le_add (norm_sub_le Z L) le_rfl)
  calc
    _ ≤ ‖P+(Z-L-S)‖+‖E‖ := norm_add_le _ _
    _ ≤ (‖P‖+‖Z-L-S‖)+‖E‖ := add_le_add (norm_add_le _ _) le_rfl
    _ ≤ _ := by linarith only [hp,hm,hs]

end

