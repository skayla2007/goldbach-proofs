private theorem norm_weighted_masked_sum_le {n : ℕ} (K D A : Finset ℕ)
    (w : ℕ → ℂ) (f g : ℕ → ℕ → ℕ → ℝ → ℂ) {T c L R : ℝ}
    (T0 : 0 ≤ T) (c0 : 0 < c) (weights : ∀ d ∈ D, ‖w d‖ ≤ T)
    (fc : ∀ k d h, Continuous (f k d h)) (gc : ∀ k d h, Continuous (g k d h))
    (energyL : ∀ k, (∑ d ∈ D, ∑ h ∈ A, ∫ t in (0 : ℝ)..1, ‖f k d h t‖^2) ≤ L)
    (energyR : ∀ k, (∑ d ∈ D, ∑ h ∈ A, ∫ t in (0 : ℝ)..1, ‖g k d h t‖^2) ≤ R) :
    ‖∑ k ∈ K, ∑ d ∈ D, ∑ h ∈ A, w d * maskedWaveProduct n (f k d h) (g k d h)‖ ≤
      (K.card : ℝ)*(T/2)*(c*L+c⁻¹*R) := by
