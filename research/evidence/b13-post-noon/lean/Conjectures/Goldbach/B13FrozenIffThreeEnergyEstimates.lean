    _ ≤ U*(U+D)+D*U := by
      exact add_le_add (mul_le_mul l0 (add_le_add r0 r1) (add_nonneg rNon rDiv) (lNon.trans l0))
        (mul_le_mul l1 r0 rNon (lDiv.trans l1))
    _ = _ := by unfold U D L; ring

end

