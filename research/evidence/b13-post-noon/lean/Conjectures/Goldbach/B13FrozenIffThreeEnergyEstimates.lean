def innerSmallModulusExtraFrom (n : ℕ) {κ : Type} (J : Finset κ)
    (v p s : κ → ℕ) (w : κ → ℂ) : ℂ :=
  rawWavePairSum n (expandedWaveItems n (bilateralLeftWaveItems n) leftBilinearStep)
    (expandedWaveItems n J v) v p s w
      (fun u m => farInnerThinGate n u m ∧ m ≤ expandedHighModulusCap n ∧ u*m ≤ expandedHyperbolaProductCap n)
      (fun u m l r a b => (pairResidueError n u m l r a b : ℂ))

private theorem small_modulus_kept_eq_cap_split (n : ℕ) {κ : Type} (J : Finset κ) (v p s : κ → ℕ) (w : κ → ℂ) :
    boundedOuterLeftKeptFrom (smallModulusProductGateAt expandedHyperbolaProductCap) n J v p s w =
      boundedOuterLeftKeptFrom smallModulusProductGate n J v p s w +
        boundedOuterLeftKeptFrom innerSmallModulusExtraGate n J v p s w := by
  unfold boundedOuterLeftKeptFrom
  simp only [← sum_add_distrib]
  refine sum_congr rfl fun i _ => sum_congr rfl fun j _ => ?_
  let u := leftBilinearStep i
  let m := v j
  let largeGate := boundedOuterLeftKeptGate (smallModulusProductGateAt expandedHyperbolaProductCap) n u m
  let oldGate := boundedOuterLeftKeptGate smallModulusProductGate n u m
  let extraGate := boundedOuterLeftKeptGate innerSmallModulusExtraGate n u m
  let value := leftBilinearWeight n i*w j*(pairResidueError n u m 0 (n/u) (p j) (s j) : ℂ)
  change (if largeGate then value else 0) =
    (if oldGate then value else 0) + (if extraGate then value else 0)
  have oldIsLarge (h : oldGate) : largeGate :=
    ⟨⟨h.1.1,h.1.2.1,h.1.2.2.trans (high_far_strip_cap_le_expanded_product n)⟩,h.2⟩
  have split (h : largeGate) : oldGate ∨ extraGate := by
    by_cases old : u*m ≤ highFarStripProductCap n
    · exact Or.inl ⟨⟨h.1.1,h.1.2.1,old⟩,h.2⟩
    · exact Or.inr ⟨⟨h.1,lt_of_not_ge old⟩,h.2⟩
  have incompatible (h : oldGate) (g : extraGate) : False :=
    (not_lt_of_ge h.1.2.2) g.1.2
  by_cases h : largeGate
  · rcases split h with old | extra
    · rw [ite_eq_left h,ite_eq_left old,ite_eq_right (incompatible old),add_zero]
    · rw [ite_eq_left h,ite_eq_right (fun old => incompatible old extra),ite_eq_left extra,zero_add]
  · rw [ite_eq_right h,ite_eq_right (fun old => h (oldIsLarge old)),
      ite_eq_right (fun extra : extraGate => h ⟨extra.1.1,extra.2⟩),add_zero]

private theorem inner_extra_kept_eq_left_divisor_split (n : ℕ) {κ : Type} (J : Finset κ)
    (v p s : κ → ℕ) (w : κ → ℂ) :
    boundedOuterLeftKeptFrom innerSmallModulusExtraGate n J v p s w =
      innerSmallModulusExtraFrom n J v p s w + innerLeftDivisorCutFrom innerSmallModulusExtraGate n J v p s w := by
  unfold boundedOuterLeftKeptFrom innerSmallModulusExtraFrom innerLeftDivisorCutFrom rawWavePairSum largeLeftDivisorResidueFamily
  simp only [← sum_add_distrib]
  refine sum_congr rfl fun i _ => sum_congr rfl fun j _ => ?_
  let u := leftBilinearStep i
  let m := v j
  have eq : (farInnerThinGate n u m ∧ m ≤ expandedHighModulusCap n ∧ u*m ≤ expandedHyperbolaProductCap n) ↔
      boundedOuterLeftKeptGate innerSmallModulusExtraGate n u m ∧ u.gcd n ≤ thinHighLeftDivisorCap n := by
    unfold farInnerThinGate boundedOuterLeftKeptGate farInnerGate innerSmallModulusExtraGate smallModulusProductGateAt
    tauto
  by_cases h : boundedOuterLeftKeptGate innerSmallModulusExtraGate n u m
  · have g : u.gcd m ≤ thinHighGcdCap n := h.2.2.1
    by_cases t : u.gcd n ≤ thinHighLeftDivisorCap n
    · have yes := eq.mpr ⟨h,t⟩
      simp [u,m,h,g,yes,not_lt.mpr t]
    · have no := fun b => t (eq.mp b).2
      rw [if_neg no]
      simp [u,m,h,g,lt_of_not_ge t]
  · have no := fun b => h (eq.mp b).1
    rw [if_neg no]
    simp [u,m,h]

theorem inner_small_modulus_extra_saving {κ : Type} (J : ℕ → Finset κ)
    (v : κ → ℕ) (b c : ℕ → κ → ℕ) (w : ℕ → κ → ℂ)
    (steps : ∀ n, ∀ j ∈ J n, v j ∈ Icc 1 n)
    (ends : ∀ n, ∀ j ∈ J n, c n j ≤ n/v j)
    (weights : ∀ n, ∀ {T : ℝ}, 1 ≤ T → (∀ u ≤ n, (u.divisors.card : ℝ) ≤ T) →
      ∀ m ∈ Icc 1 n, (∑ j ∈ (J n).filter (fun j => v j=m), ‖w n j‖) ≤ T^3*logBudget n) :
    saving (fun n => innerSmallModulusExtraFrom n (J n) v (b n) (c n) (w n)) := by
  have whole := small_modulus_product_kept_from_saving_at expandedHyperbolaProductCap
    (fun _ => le_rfl) J v b c w steps ends weights
  have old := small_modulus_product_kept_from_saving J v b c w steps ends weights
  have added := (saving_equiv_of_negligible_correction
    (fun n => (small_modulus_kept_eq_cap_split n (J n) v (b n) (c n) (w n)).trans (add_comm _ _))
    old).mp whole
  have large := inner_left_divisor_cut_saving innerSmallModulusExtraGate J v b c w steps weights
  exact (saving_equiv_of_negligible_correction
    (fun n => inner_extra_kept_eq_left_divisor_split n (J n) v (b n) (c n) (w n)) large).mp added

end

