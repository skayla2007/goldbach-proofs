    by_contra! h
    have m0 : m = 0 := by omega
    simpa [m0] using (mem_Ioc.mp hit).1
  have rightSupp (j : RightLowWaveIndex) (hj : j ∈ outsideProperPowerItems n)
      (m : ℕ) (hm : m ≤ n) (d : rightLowWaveStep j ∣ m)
      (hit : m/rightLowWaveStep j ∈ Ioc 0 (rightLowWaveUpper n j)) : m ∈ SR := by
    have m0 : 0 < m := by
      by_contra! h
      have zero : m = 0 := by omega
      simpa [zero] using (mem_Ioc.mp hit).1
    obtain ⟨base,_,nonprime,hpow⟩ := mem_filter.mp hj
    have above := (mem_Ioc.mp (mem_sigma.mp base).1).1
