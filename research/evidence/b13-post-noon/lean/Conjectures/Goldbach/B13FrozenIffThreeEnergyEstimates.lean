theorem weil_near_right_ramp_saving
    (R : ℕ → Finset RightLowWaveIndex) (lower upper : ModerateLowBounds)
    (support : ∀ n, ∀ j ∈ R n, j ∈ rightLowWaveItems n ∧
      (rightLowWaveStep j : ℝ) ≤ (n : ℝ)^(37/64 : ℝ) ∧
