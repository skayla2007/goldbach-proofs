    (leftBilinearStep i ≤ expandedWideStepCap n ∧ rightLowWaveStep j ≤ expandedWideStepCap n) ∧
      middleLowAnalyticGateAt C lowerCap upperCap farOnly n (leftBilinearStep i) (rightLowWaveStep j)
  have lhs :
      moderateLowActualSlice (middleLowProductRows lowerCap upperCap J)
        (middleLowProductLower farOnly) (middleLowProductUpperAt C) n =
