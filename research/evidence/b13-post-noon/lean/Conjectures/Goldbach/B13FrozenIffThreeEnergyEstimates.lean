  rw [far_inner_thin_split_right n (lowPrimeItems n) rightLowWaveStep (fun _ => 0)
    (rightLowWaveUpper n) rightLowWaveWeight (rightStepIsShort n)]
  rw [outside_target_kept_split_right n (lowPrimeItems n) rightLowWaveStep (fun _ => 0)
