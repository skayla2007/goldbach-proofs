    arithmeticOutsideExpanded n =
      outsideExpandedAfterProperPower n + outsideProperPowerContribution n := by
  change outsideExpandedFrom n ((rightLowWaveItems n).filter (fun j => ¬j.1 ∣ n))
      rightLowWaveStep (fun _ => 0) (rightLowWaveUpper n) rightLowWaveWeight + _ = _
  unfold outsideExpandedAfterProperPower
