    (no : ¬∃ b : ℕ, b ∣ m ∧ P < b ∧ ¬b.Prime ∧ IsPrimePow b) :
    restrictedVaughanFactor P (fun b => ¬b.Prime ∧ IsPrimePow b) m = 0 := by
