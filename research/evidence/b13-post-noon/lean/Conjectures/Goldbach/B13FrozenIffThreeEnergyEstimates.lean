    obtain ⟨x,hx,e⟩ := liftSurj j hj
    exact ⟨x,hx,e⟩
  intro x hx y hy e
  have pEq : x.2=y.2 := congrArg Sigma.fst e
  have qEq : x.1=y.1 := congrArg (fun j : RightLowWaveIndex => j.2) e
  exact Sigma.ext qEq (heq_of_eq pEq)

end

end GoldbachTypeII13

