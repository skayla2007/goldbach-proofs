    properPowerSquareCut n ∈ Icc 1 n := by
  have r1 : (1 : ℝ) ≤ n := by exact_mod_cast n1
  have upper : (properPowerSquareCut n : ℝ) ≤ n :=
    (Nat.floor_le (by positivity)).trans (Real.rpow_le_self_of_one_le r1 (by norm_num))
  exact mem_Icc.mpr ⟨Nat.le_floor (Real.one_le_rpow r1 (by norm_num)), by exact_mod_cast upper⟩

theorem card_proper_power_square_support_le {n : ℕ} (n1 : 1 ≤ n) :
    ((squareMultipleSupport n (properPowerSquareCut n)).card : ℝ) ≤ 2*(n : ℝ)^(47/48 : ℝ) := by
  obtain ⟨A0,An⟩ := mem_Icc.mp (proper_power_square_cut_range n1)
  have nR : (1 : ℝ) ≤ n := by exact_mod_cast n1
  have low : (n : ℝ)^(1/48 : ℝ)/2 ≤ (properPowerSquareCut n : ℝ) :=
    floor_half_le (Real.one_le_rpow nR (by norm_num))
