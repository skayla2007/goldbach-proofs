noncomputable section

private def lowInteriorLeftItems (n : ℕ) : Finset (ℕ × ℕ) :=
  (expandedWaveItems n (bilateralLeftWaveItems n) leftBilinearStep).filter
    (fun i => ⌊(n : ℝ)^(27/64 : ℝ)⌋₊ < leftBilinearStep i)

private def highInteriorLeftItems (n : ℕ) : Finset (ℕ × ℕ) :=
  expandedWaveItems n (bilateralLeftWaveItems n) leftBilinearStep

private def highInteriorRightItems (n : ℕ) : Finset RightHighWaveIndex :=
  expandedWaveItems n (longRightHighItems n) rightHighWaveStep

private def lowInteriorGate (n u v : ℕ) : Prop :=
  retainedLowTargetMask n u v ∧ stepWithoutLargeSquare n u

private def highInteriorGate (n u v : ℕ) : Prop :=
  squareFreeInnerMask n (retainedAfterHighWider n) u v

def afterSymmetricInterior (n : ℕ) : ℂ :=
  (symmetricInnerFamily n (lowInteriorLeftItems n) (longRightLowItems n) rightLowWaveStep
      (fun _ => 0) (leftPrimeWeight n) rightLowWaveWeight (lowInteriorGate n) (symmetricResidueError n) +
    symmetricInnerFamily n (highInteriorLeftItems n) (highInteriorRightItems n) rightHighWaveStep
      (rightHighWaveLower n) (leftPrimeWeight n) (rightHighPrimeWeight n) (highInteriorGate n)
      (symmetricResidueError n)) +
  (lowExteriorAfterGeometry n +
    outsideSharpCommonKept n (longRightHighItems n) rightHighWaveStep (rightHighWaveLower n)
      (fun j => n/rightHighWaveStep j) (rightHighPrimeWeight n))

private def symmetricInteriorCorrection (n : ℕ) : ℂ :=
  symmetricInnerCorrection n (lowInteriorLeftItems n) (longRightLowItems n) rightLowWaveStep
      (fun _ => 0) (leftPrimeWeight n) rightLowWaveWeight (lowInteriorGate n) +
    symmetricInnerCorrection n (highInteriorLeftItems n) (highInteriorRightItems n) rightHighWaveStep
      (rightHighWaveLower n) (leftPrimeWeight n) (rightHighPrimeWeight n) (highInteriorGate n)

private theorem symmetric_interior_correction_saving : saving symmetricInteriorCorrection := by
  have lowLeftBase (n : ℕ) : lowInteriorLeftItems n ⊆ bilateralLeftWaveItems n :=
    (filter_subset _ _).trans (filter_subset _ _)
  have lowRight (n : ℕ) (hn : 0 < n) (j : RightLowWaveIndex) (hj : j ∈ longRightLowItems n) :
      rightLowWaveStep j ∈ Icc 1 (expandedWideStepCap n) :=
    mem_Icc.mpr ⟨(mem_Icc.mp (bilateral_right_low_step_range (long_right_low_subset n hj))).1,
      long_right_low_step_within_expanded hn hj⟩
  have highRightBase (n : ℕ) : highInteriorRightItems n ⊆ rightHighWaveItems n :=
    (filter_subset _ _).trans (filter_subset _ _)
  have highRight (n : ℕ) (_ : 0 < n) (j : RightHighWaveIndex) (hj : j ∈ highInteriorRightItems n) :
      rightHighWaveStep j ∈ Icc 1 (expandedWideStepCap n) :=
    mem_Icc.mpr ⟨(mem_Icc.mp (bilateral_right_high_step_range (highRightBase n hj))).1,
      (mem_filter.mp hj).2⟩
  have highMass (n : ℕ) (T : ℝ) (T1 : 1 ≤ T) (d : ∀ m ≤ n, (m.divisors.card : ℝ) ≤ T)
      (q : ℕ) (hq : q ∈ Icc 1 n) :
