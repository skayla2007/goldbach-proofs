def lowInteriorAfterGeometry (n : ℕ) : ℂ :=
  selectedInnerResidue n
    ((expandedWaveItems n (bilateralLeftWaveItems n) leftBilinearStep).filter
      (fun i => ⌊(n : ℝ)^(27/64 : ℝ)⌋₊ < leftBilinearStep i))
    (longRightLowItems n) rightLowWaveStep (fun _ => 0) (fun j => n/rightLowWaveStep j)
    (leftPrimeWeight n) rightLowWaveWeight
    (fun u v => retainedLowTargetMask n u v ∧ stepWithoutLargeSquare n u)

theorem low_interior_eq_after_geometry {n : ℕ} (hn : 0 < n) :
    lowMiddleTerm n (squareFreeInnerMask n (retainedLowTargetMask n)) =
      lowInteriorAfterGeometry n := by
  have full : expandedWaveItems n (longRightLowItems n) rightLowWaveStep = longRightLowItems n :=
    filter_eq_self.mpr fun _ hj => long_right_low_step_within_expanded hn hj
  unfold lowMiddleTerm onExpandedSteps lowInteriorAfterGeometry
  rw [full]
  symm
  unfold selectedInnerResidue
  rw [sum_filter]
  refine sum_congr rfl fun i hi => ?_
  dsimp only
  by_cases large : ⌊(n : ℝ)^(27/64 : ℝ)⌋₊ < leftBilinearStep i
  · rw [if_pos large]
    refine sum_congr rfl fun j hj => ?_
    rw [long_right_low_upper_eq_div hn hj]
    by_cases zero : rightLowWaveWeight j = 0
    · simp [zero]
    · let u := leftBilinearStep i
      let v := rightLowWaveStep j
      have sq := long_right_low_square_kept_of_ne_zero hn hj zero
      unfold squareFreeInnerMask
      by_cases keep : farInnerThinGate n u v ∧
          (retainedLowTargetMask n u v ∧ stepWithoutLargeSquare n u)
      · rw [if_pos keep,if_pos (show farInnerThinGate n u v ∧
            ((retainedLowTargetMask n u v ∧ stepWithoutLargeSquare n u) ∧ stepWithoutLargeSquare n v)
          from ⟨keep.1,keep.2,sq⟩)]
      · rw [if_neg keep,if_neg (fun h : farInnerThinGate n u v ∧
            ((retainedLowTargetMask n u v ∧ stepWithoutLargeSquare n u) ∧ stepWithoutLargeSquare n v) =>
          keep ⟨h.1,h.2.1⟩)]
  · rw [if_neg large]
    symm
    apply sum_eq_zero
    intro j hj
    exact if_neg (fun h => large (long_low_inside_left_ge hn hj h.1))

def lowExteriorAfterGeometry (n : ℕ) : ℂ :=
  ∑ i ∈ ((outsideLeftTargetItems n).filter (fun i => stepWithoutLargeSquare n (leftBilinearStep i))).filter
        (fun i => expandedWideStepCap n < leftBilinearStep i),
    ∑ j ∈ (longRightLowItems n).filter (fun j => j.2.gcd n ≤ sparseTargetDivisorCap n),
      let u := leftBilinearStep i
      let v := rightLowWaveStep j
      if maximumStep n^2 < u*v ∧ u.gcd v ≤ min (exteriorSharpCommonDivisorCap n) (maximumStep n) then
        leftPrimeWeight n i*rightLowWaveWeight j*residueWindowPair n u v 0 (n/u) 0 (n/v)
      else 0

theorem low_exterior_eq_after_geometry {n : ℕ} (hn : 0 < n) :
    outsideSharpCommonKept n (longRightLowItems n) rightLowWaveStep (fun _ => 0)
      (rightLowWaveUpper n) rightLowWaveWeight = lowExteriorAfterGeometry n := by
  let I := (outsideLeftTargetItems n).filter (fun i => stepWithoutLargeSquare n (leftBilinearStep i))
  let J := outsideRightTargetItems n (longRightLowItems n) rightLowWaveStep
  let M := min (exteriorSharpCommonDivisorCap n) (maximumStep n)
  let w := rightLowWaveWeight
  let a := leftPrimeWeight n
  let u := leftBilinearStep
  let v := rightLowWaveStep
  let square (j : RightLowWaveIndex) := stepWithoutLargeSquare n (v j)
  let outer (i : ℕ × ℕ) := expandedWideStepCap n < u i
  let G (i : ℕ × ℕ) (j : RightLowWaveIndex) := maximumStep n^2 < u i*v j ∧ (u i).gcd (v j) ≤ M
  let F (i : ℕ × ℕ) (j : RightLowWaveIndex) (b : ℕ) : ℂ :=
    a i*w j*residueWindowPair n (u i) (v j) 0 (n/u i) 0 b
  have R : (longRightLowItems n).filter (fun j => j.2.gcd n ≤ sparseTargetDivisorCap n) = J := by
    ext j
    unfold J outsideRightTargetItems
    rw [mem_filter,mem_filter]
    unfold targetDivisorKept
    constructor <;> rintro ⟨hj,hg⟩
    · exact ⟨hj,by rwa [long_right_low_gcd_eq hj]⟩
    · exact ⟨hj,by rwa [← long_right_low_gcd_eq hj]⟩
  unfold lowExteriorAfterGeometry
  rw [R]
  change (∑ i ∈ I, ∑ j ∈ J.filter square,
    @ite ℂ (G i j ∧ outsideStepCap (expandedWideStepCap n) (u i) (v j)) (Classical.propDecidable _)
      (F i j (rightLowWaveUpper n j)) 0) =
    ∑ i ∈ I.filter outer, ∑ j ∈ J, (if G i j then F i j (n/v j) else 0)
  rw [sum_filter (s := I) outer]
  refine sum_congr rfl fun i _ => ?_
  rw [sum_filter (s := J) square]
  by_cases hi : outer i
  · rw [if_pos hi]
    refine sum_congr rfl fun j hj => ?_
    have hJ : j ∈ longRightLowItems n := (mem_filter.mp hj).1
    have geom : outsideStepCap (expandedWideStepCap n) (u i) (v j) := fun h => (not_le_of_gt hi) h.1
    by_cases zero : w j = 0
    · simp [F,zero]
    · have keep : square j := long_right_low_square_kept_of_ne_zero hn hJ zero
      simp only [if_pos keep,geom,and_true,long_right_low_upper_eq_div hn hJ]
      by_cases permit : G i j <;> simp [permit,v]
  · rw [if_neg hi]
    apply sum_eq_zero
    intro j hj
    have hJ : j ∈ longRightLowItems n := (mem_filter.mp hj).1
    have vi : v j ≤ expandedWideStepCap n := long_right_low_step_within_expanded hn hJ
    have miss : ¬outsideStepCap (expandedWideStepCap n) (u i) (v j) :=
      fun h => h ⟨le_of_not_gt hi,vi⟩
    simp [miss]

def afterLowGeometry (n : ℕ) : ℂ :=
  (lowInteriorAfterGeometry n + retainedExpandedHigh n (squareFreeInnerMask n (retainedAfterHighWider n))) +
    (lowExteriorAfterGeometry n +
      outsideSharpCommonKept n (longRightHighItems n) rightHighWaveStep (rightHighWaveLower n)
        (fun j => n/rightHighWaveStep j) (rightHighPrimeWeight n))

theorem frozen_iff_after_low_geometry : frozenGoal ↔ saving afterLowGeometry := by
  rw [frozen_iff_after_sharp_exterior_common_cut]
  constructor <;> intro h e he <;> obtain ⟨N,hN⟩ := h e he <;>
    refine ⟨max N 1,fun n hn even => ?_⟩ <;>
    have eq : afterSharpExteriorCommonCut n = afterLowGeometry n := by
      unfold afterSharpExteriorCommonCut afterLowGeometry
      rw [low_interior_eq_after_geometry (by omega),low_exterior_eq_after_geometry (by omega)]
  · rw [← eq]
    exact hN n (by omega) even
  · rw [eq]
    exact hN n (by omega) even

end

end GoldbachTypeII13

