    (u l r : α → ℕ) (v p s : β → ℕ) (a : α → ℂ) (b : β → ℂ)
    {W T : ℝ} (W0 : 0 ≤ W)
    (left : ∀ i ∈ I, u i ∈ Icc 1 n) (right : ∀ j ∈ J, v j ∈ Icc 1 n)
    (leL : ∀ i ∈ I, r i ≤ n/u i) (leR : ∀ j ∈ J, s j ≤ n/v j)
    (massL : ∀ x ∈ Icc 1 n, (∑ i ∈ I.filter (fun i => u i=x), ‖a i‖) ≤ W)
    (massR : ∀ x ∈ Icc 1 n, (∑ j ∈ J.filter (fun j => v j=x), ‖b j‖) ≤ W)
    (divisors : ∀ m ≤ n, (m.divisors.card : ℝ) ≤ T)
